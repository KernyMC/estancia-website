---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import MenuNav from '../../components/MenuNav.astro';
import Cta from '../../components/Cta.astro';

const tiles = [
  { href: '/menu/churrasco/', title: 'Churrasco', note: '15 fire-roasted cuts carved tableside', img: '/img/w/ish_0061-1.jpg' },
  { href: '/menu/salad-bar/', title: 'Salad Bar', note: '40+ gourmet items, keto & gluten-free', img: '/img/w/dsc01088.jpg' },
  { href: '/menu/sides/', title: 'Sides', note: 'Traditional Brazilian accompaniments', img: '/img/w/img_5067-e1775582191954.jpg' },
  { href: '/menu/brunch/', title: 'Brunch', note: 'Saturday & Sunday, 11:00 am – 3:30 pm', img: '/img/w/brunch-4-small.jpg' },
  { href: '/menu/bar/', title: 'Bar', note: 'Cocktails, wine, happy hour', img: '/img/w/barflightdrinks.jpg' },
  { href: '/menu/dessert/', title: 'Dessert', note: 'A sweet Brazilian ending', img: '/img/w/20.jpg' },
];
---

<Base title="Menu" description="The Estância menu: fire-roasted churrasco, gourmet salad bar, traditional Brazilian sides, weekend brunch, craft cocktails and desserts.">
  <PageHero kicker="The menu" title="Everything on the <em>table</em>" lead="One continuous experience: salad bar, sides and prime meats carved at your seat, finished with something sweet." image="/img/w/capa-de-revista2_.jpg" crumbs={[{ label: 'Menu' }]} />
  <MenuNav />
  <section class="sec sec--dark">
    <div class="wrap">
      <div class="cards" data-stagger>
        {tiles.map((t) => (
          <a class="card" href={t.href}>
            <div class="mask"><img src={t.img} alt="" loading="lazy" /></div>
            <div class="card__body"><span class="card__meta">{t.note}</span><h3>{t.title}</h3></div>
          </a>
        ))}
      </div>
      <p class="note" style="margin-top:3.5rem">*These items may be served raw or undercooked, or contain raw undercooked ingredients. Consuming raw or undercooked meats, poultry, seafood, or eggs may increase your risk of food-borne illness. Meat offerings may change due to seasonality and availability. Prices and à la carte menus differ by location &mdash; see <a href="/austin/menu/" style="color:var(--gold)">Austin</a> and <a href="/leander/menu/" style="color:var(--gold)">Leander</a>.</p>
    </div>
  </section>
  <Cta />
</Base>
