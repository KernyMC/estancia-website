---
import { locations, hours, social, footerLinks, legalLinks, nav } from '../data/site';
const { austin, leander } = locations;
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <img class="logo" src="/img/w/primary-white-and-gold-3.png" alt="Estância Brazilian Steakhouse" width="190" height="65" loading="lazy" />
      <p>Fire-roasted prime meats carved tableside, a gourmet salad bar and Brazilian hospitality in Austin and Leander, Texas.</p>
      <ul class="footer-social" aria-label="Social media">
        {social.map((s) => (
          <li>
            <a href={s.url} rel="noopener" target="_blank" aria-label={`${s.label} (opens in a new tab)`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {s.label === 'Instagram' && (<><rect x="2.5" y="2.5" width="19" height="19" rx="5" /><circle cx="12" cy="12" r="4.5" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></>)}
                {s.label === 'Facebook' && (<path d="M15 8.5h2V5h-2.5A3.5 3.5 0 0 0 11 8.5V11H9v3h2v6.5h3V14h2.4l.6-3h-3v-2a1 1 0 0 1 1-.5Z" />)}
                {s.label === 'TikTok' && (<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.3 2.3 1.9 4 4.5 4.2" />)}
                {s.label === 'YouTube' && (<><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="m10 9.5 5 2.5-5 2.5Z" /></>)}
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <a class="award" href="https://threebestrated.com/steak-houses-in-austin-tx" target="_blank" rel="noopener" aria-label="Three Best Rated: best steak houses in Austin, TX, 2025 (opens in a new tab)">
        <img src="/img/w/award-three-best-rated.svg" alt="Three Best Rated award: steak houses in Austin, Texas, 2025" width="120" height="120" loading="lazy" />
      </a>
    </div>
    <div>
      <p class="foot-h">Austin</p>
      <p>{austin.address}<br />{austin.cityLine}</p>
      <p><a href={`tel:${austin.phone.replace(/\D/g, '')}`}>{austin.phone}</a></p>
      <p><a href="/austin/">Details</a> &middot; <a href={austin.mapUrl} target="_blank" rel="noopener">Directions</a></p>
      <p class="foot-h" style="margin-top:2rem">Leander</p>
      <p>{leander.address}<br />{leander.cityLine}</p>
      <p><a href={`tel:${leander.phone.replace(/\D/g, '')}`}>{leander.phone}</a></p>
      <p><a href="/leander/">Details</a> &middot; <a href={leander.mapUrl} target="_blank" rel="noopener">Directions</a></p>
    </div>
    <div>
      <p class="foot-h">Hours</p>
      <ul>
        {hours.map((h) => <li><strong style="color:#ddd;font-weight:500">{h.days}</strong><br />{h.lines.join(' · ')}</li>)}
      </ul>
    </div>
    <div>
      <p class="foot-h">Explore</p>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap footer__bar">
    <span>&copy; {new Date().getFullYear()} Estância Brazilian Steakhouse. All rights reserved.</span>
    <nav class="footer__legal" aria-label="Legal">{legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
  </div>
</footer>
