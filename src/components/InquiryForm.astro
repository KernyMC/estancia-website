---
import FormConsent from './FormConsent.astro';
interface Props { location?: 'austin' | 'leander'; dark?: boolean; holiday?: boolean }
const { location = 'austin', holiday = false } = Astro.props;
// Campos tomados del calculador de grupos original (estancia.com/group-dining-calculator/)
const types = ['Corporate event or meeting', 'Birthday', 'Anniversary', 'Wedding party', 'Holiday', 'Church', 'School or non-profit', 'Convention related event', 'Full restaurant buyout', 'Graduation', 'Social event or celebration', 'Bachelor or bachelorette', 'Other'];
const packages = [
  ['', 'Not sure yet'],
  ['experience', 'Estância Experience (open bar)'],
  ['p1', 'Package 1 (3 drinks)'],
  ['p2', 'Package 2 (2 drinks)'],
  ['p3', 'Package 3 (dessert)'],
  ['p4', 'Package 4 (soft drinks)'],
];
---

<form class="form form--3" data-demo>
  <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" required autocomplete="name" /></div>
  <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" required autocomplete="email" /></div>
  <div class="field"><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" /></div>
  <div class="field"><label for="f-company">Company</label><input id="f-company" name="company" autocomplete="organization" /></div>
  <div class="field"><label for="f-type">Type of event</label>
    <select id="f-type" name="type">{types.map((t) => <option selected={holiday && t === 'Holiday'}>{t}</option>)}</select></div>
  <div class="field"><label for="f-guests">Guests (12+)</label><input id="f-guests" name="guests" type="number" min="12" placeholder="12+" /></div>
  <div class="field"><label for="f-date">Ideal date</label><input id="f-date" name="date" type="date" /></div>
  <div class="field"><label for="f-flex">Date flexibility</label>
    <select id="f-flex" name="flex"><option>I am open to other dates</option><option>I might be open to it</option><option>Not flexible at all</option></select></div>
  <div class="field"><label for="f-time">Time of day</label>
    <select id="f-time" name="time"><option>Monday – Friday lunch</option><option>Monday – Sunday dinner</option><option>Saturday or Sunday brunch</option></select></div>
  <div class="field"><label for="f-loc">Location</label>
    <select id="f-loc" name="location"><option value="austin" selected={location === 'austin'}>Austin</option><option value="leander" selected={location === 'leander'}>Leander</option></select></div>
  <div class="field"><label for="f-room">Private room</label>
    <select id="f-room" name="room"><option>Fully private</option><option>Non-private table is fine</option><option>Private preferred</option></select></div>
  <div class="field"><label for="f-pkg">Package</label>
    <select id="f-pkg" name="package">{packages.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
  <div class="field full"><label for="f-msg">Notes and special requests</label><textarea id="f-msg" name="message" rows="2"></textarea></div>
  <FormConsent kind="inquiry" />
  <input class="honey" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="full"><button class="btn btn--dark" type="submit" data-magnetic>Send inquiry <i class="ico ico-arrow arr" aria-hidden="true"></i></button></div>
  <p class="note full" style="color:#6b665a">Estimates are based on per-person pricing and may include 8.25% tax, 20% gratuity and a 3% admin fee. Private dining requires a food &amp; beverage minimum; our events team will send an all-inclusive quote.</p>
  <p class="form-note full" role="status">Thank you! Our events team will contact you soon. <em>(Demo build: nothing was sent.)</em></p>
</form>
