{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(sanity dataset delete:*)",
      "Bash(pnpm sanity dataset delete:*)",
      "Bash(npx sanity dataset delete:*)",
      "Bash(sanity dataset import:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(git push --force:*)"
    ]
  }
}
