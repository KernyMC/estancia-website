---
/**
 * Post-payment landing.
 *
 * Stripe redirects here with ?session_id= — the webhook may not have arrived
 * yet when the buyer lands, so a still-pending order is shown as
 * "processing" (refreshing shows it confirmed).
 *
 * PayPal lands here with ?paypal_order_id= AFTER our own capture-order call
 * already confirmed payment server-side (see the checkout client's PayPal
 * button handler), so a PayPal order here is always already `paid`.
 */
import Base from '../../layouts/Base.astro';
import { getOrderByStripeSession, getOrderByPaypalOrder } from '../../server/orders/orders';
import { formatDateRange } from '../../lib/availability';

const sessionId = Astro.url.searchParams.get('session_id');
const paypalOrderId = Astro.url.searchParams.get('paypal_order_id');
const order = sessionId
  ? await getOrderByStripeSession(sessionId)
  : paypalOrderId
    ? await getOrderByPaypalOrder(paypalOrderId)
    : null;

if (!order) {
  return Astro.redirect('/');
}

const confirmed = order.status === 'paid';

function formatUsd(cents: number): string {
  return `$${(cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
}
---

<Base title="Booking confirmation | Galápagos & Beyond" description="Your booking confirmation.">
  <section class="container confirmation">
    <div class="confirmation-card">
      <div class="mark" aria-hidden="true">{confirmed ? '✓' : '⏳'}</div>
      <h1>{confirmed ? 'Booking confirmed!' : 'Payment received, confirming…'}</h1>
      <p class="intro">
        {
          confirmed
            ? `Thank you, ${order.customer.name}. A confirmation email is on its way to ${order.customer.email}.`
            : 'Your payment went through and we are finalizing your booking. You will receive a confirmation email shortly.'
        }
      </p>

      <p class="order-ref">Order reference: <strong>{order.id}</strong></p>

      <ul class="order-items">
        {
          order.items.map((item) => (
            <li class="order-item">
              <p class="item-name">{item.itemName}</p>
              {item.departureStart && item.departureEnd && (
                <p class="item-meta">{formatDateRange(item.departureStart, item.departureEnd)}</p>
              )}
              <p class="item-meta">
                {item.adults} adult{item.adults === 1 ? '' : 's'}
                {item.children > 0 && `, ${item.children} child${item.children === 1 ? '' : 'ren'}`}
              </p>
              <p class="item-subtotal">{formatUsd(item.amountCents)}</p>
            </li>
          ))
        }
      </ul>

      <dl class="summary">
        <div>
          <dt>Total</dt>
          <dd>{formatUsd(order.amountCents)} {order.currency.toUpperCase()}</dd>
        </div>
      </dl>

      <p class="next">Our team will contact you with full trip details and next steps.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
</Base>

<script>
  // Only place the cart is cleared: by the time the buyer is here, the
  // payment attempt has concluded (Stripe completed the redirect, or PayPal
  // was already captured server-side before this page loaded) — clearing
  // earlier (e.g. on redirect to Stripe) would lose the cart on a bounce.
  import { clearCart } from '../../scripts/cart-store';
  clearCart();
</script>

<style>
  .confirmation {
    display: grid;
    place-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .confirmation-card {
    max-width: 560px;
    width: 100%;
    text-align: center;
    padding: clamp(2rem, 5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-soft);
  }

  .mark {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .confirmation-card h1 {
    font-size: var(--text-2xl);
  }

  .intro {
    color: var(--ink-soft);
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .order-ref {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .order-items {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .order-item {
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .order-item:last-child {
    border-bottom: none;
  }

  .item-name {
    font-weight: 650;
    font-size: var(--text-sm);
  }

  .item-meta {
    color: var(--ink-soft);
    font-size: var(--text-xs);
    margin-top: 0.2rem;
  }

  .item-subtotal {
    margin-top: 0.35rem;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .summary {
    margin: 0.75rem 0 1.75rem;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .summary > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    font-size: var(--text-sm);
  }

  .summary dt {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .summary dd {
    font-weight: 700;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .next {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }
</style>
