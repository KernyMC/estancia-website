---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getStays } from '../../lib/content';

const stays = await getStays();
---

<Base
  title="Places to Stay | Galápagos & Beyond"
  description="Our own condos in Santa Cruz, Galápagos, and in Quito, run by the same team that plans your trip."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Stays' }]} />

  <section class="hub-hero">
    <img src="/images/banner-stays.avif" alt="" class="hub-hero-img" fetchpriority="high" />
    <div class="hub-hero-overlay" aria-hidden="true"></div>
    <div class="container hub-hero-content">
      <p class="eyebrow">Places to stay</p>
      <h1>Stays</h1>
      <p class="hub-intro">
        Home base, before and after the islands: our own condos in Puerto
        Ayora and Quito, run by the same team that plans your cruises and
        tours.
      </p>
    </div>
  </section>

  <section class="hub-list">
    <div class="container">
      <ul class="stay-grid">
        {
          stays.map((stay) => (
            <li>
              <a class="stay-card" href={stay.slug === 'condo-galapagos' ? '/condo-galapagos/' : `/stays/${stay.slug}/`}>
                <div class="stay-img-wrap">
                  {stay.thumbnail && <img src={stay.thumbnail} alt={stay.name} loading="lazy" />}
                  {stay.floors.length > 0 && <span class="stay-chip">{stay.floors.length} condos</span>}
                  {stay.floors.length === 0 && stay.rooms.length > 0 && <span class="stay-chip">{stay.rooms.length} rooms</span>}
                </div>
                <div class="stay-body">
                  <h2>{stay.name}</h2>
                  {stay.location && <p class="stay-location">{stay.location}</p>}
                  {stay.description && <p class="stay-excerpt">{stay.description}</p>}
                  <span class="stay-link">
                    See rooms & photos
                    <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M9 6l6 6-6 6" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hub-hero {
    position: relative;
    height: min(42dvh, 380px);
    overflow: hidden;
    background: var(--sand);
  }

  .hub-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hub-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 25, 46, 0.2) 0%, rgba(16, 25, 46, 0.72) 100%);
  }

  .hub-hero-content {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 100%;
    padding-bottom: 2rem;
  }

  .hub-hero .eyebrow {
    color: var(--white);
    margin-bottom: 0.6rem;
  }

  .hub-hero h1 {
    font-size: var(--text-hero);
    max-width: 18ch;
    color: var(--white);
  }

  .hub-intro {
    margin-top: 1.1rem;
    max-width: 62ch;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-lg);
  }

  .hub-list {
    background: var(--sand);
    padding-block: 2rem clamp(3rem, 7vw, 5rem);
  }

  .stay-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .stay-card {
    display: block;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.25s ease, translate 0.25s ease;
  }

  .stay-card:hover {
    box-shadow: var(--shadow-soft);
    translate: 0 -3px;
  }

  .stay-img-wrap {
    position: relative;
    background: var(--sand);
  }

  .stay-img-wrap img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .stay-chip {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    background: rgba(16, 25, 46, 0.72);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }

  .stay-body {
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .stay-body h2 {
    font-size: var(--text-xl);
  }

  .stay-location {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .stay-excerpt {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stay-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0.9rem;
    font-size: var(--text-sm);
    font-weight: 620;
    color: var(--brand-deep);
  }

  .stay-link .chevron-icon {
    width: 14px;
    height: 14px;
  }

  .stay-card:hover .stay-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .stay-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
