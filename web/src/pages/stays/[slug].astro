---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GalleryTabs from '../../components/ship/GalleryTabs.astro';
import FaqSection from '../../components/FaqSection.astro';
import RoomsGrid from '../../components/stay/RoomsGrid.astro';
import StayInquiryForm from '../../components/stay/StayInquiryForm.astro';
import ReviewCard from '../../components/reviews/ReviewCard.astro';
import { getStays, getStay, getStayReviews } from '../../lib/content';
import { toParagraphs } from '../../lib/text';
import { lodgingLd } from '../../lib/seo';

const { slug } = Astro.params;

// Condo Galápagos has its own dedicated page (floor-by-floor layout) —
// don't also serve it through the generic stay template.
if (slug === 'condo-galapagos') {
  return Astro.redirect('/condo-galapagos/', 301);
}

const stay = slug ? await getStay(slug) : undefined;

if (!stay) {
  return Astro.redirect('/stays/');
}

const [reviews, allStays] = await Promise.all([getStayReviews(stay.slug), getStays()]);
const other = allStays.find((s) => s.slug !== stay.slug);
const descriptionParagraphs = toParagraphs(stay.description ?? '');

const stayUrl = `/stays/${stay.slug}/`;
const stayJsonLd = lodgingLd({
  name: stay.name,
  description: stay.description ?? undefined,
  image: stay.heroImage ?? undefined,
  url: stayUrl,
  areaServed: stay.location ?? undefined,
});
---

<Base
  title={`${stay.name}${stay.location ? `, ${stay.location}` : ''}`}
  description={`${stay.name}${stay.location ? ` in ${stay.location}` : ''}, run by the Galápagos & Beyond team.`}
  canonical={stayUrl}
  image={stay.heroImage ?? undefined}
  jsonLd={stayJsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Stays', href: '/stays/' },
      { label: stay.name },
    ]}
  />
  <section class="stay-hero">
    {stay.heroImage && <img src={stay.heroImage} alt={stay.name} class="hero-img" fetchpriority="high" />}
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1>{stay.name}</h1>
      {stay.location && <p class="hero-meta">{stay.location}</p>}
    </div>
  </section>

  <div class="container stay-layout">
    <div class="stay-main">
      {
        (descriptionParagraphs.length > 0 || stay.highlights.length > 0) && (
          <section class="block" aria-labelledby="about-heading">
            <h2 id="about-heading">About this place</h2>
            {descriptionParagraphs.map((p) => <p class="lead-text">{p}</p>)}

            {stay.highlights.length > 0 && (
              <ul class="highlight-list">
                {stay.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      {
        stay.amenities.length > 0 && (
          <section class="block" aria-labelledby="amenities-heading">
            <h2 id="amenities-heading">Amenities</h2>
            <ul class="amenity-grid">
              {stay.amenities.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        stay.gallery.length > 0 && (
          <section class="block" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading">Photos</h2>
            <GalleryTabs tabs={stay.gallery} shipName={stay.name} />
          </section>
        )
      }

      <section class="block" aria-labelledby="rooms-heading">
        <h2 id="rooms-heading">Rooms</h2>
        {
          stay.rooms.length > 0 ? (
            <RoomsGrid rooms={stay.rooms} stayName={stay.name} />
          ) : (
            <p class="rooms-empty">Room-by-room details and photos are on their way, ask us directly in the meantime.</p>
          )
        }
      </section>

      {
        reviews.length > 0 && (
          <section class="block" aria-labelledby="reviews-heading">
            <h2 id="reviews-heading">What guests say</h2>
            <ul class="review-list">
              {reviews.map((r) => (
                <ReviewCard review={r} />
              ))}
            </ul>
          </section>
        )
      }

      <FaqSection faqs={stay.faq} title={`${stay.name}: frequently asked questions`} />
    </div>

    <aside class="stay-sidebar">
      <div class="sidebar-sticky">
        <div class="sidebar-card">
          <p class="sidebar-label">Interested?</p>
          <p class="sidebar-title">{stay.name}</p>
          {stay.location && <p class="sidebar-meta">{stay.location}</p>}
          <StayInquiryForm stay={stay} />
          {
            stay.airbnbUrl && (
              <a class="btn check-availability" href={stay.airbnbUrl} target="_blank" rel="noopener">
                <img src="/logos/air-bnb-logo.svg" alt="" loading="lazy" class="airbnb-logo" />
                Check Availability
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            )
          }
        </div>

        {
          other && (
            <a class="other-card" href={other.slug === 'condo-galapagos' ? '/condo-galapagos/' : `/stays/${other.slug}/`}>
              {other.thumbnail && <img src={other.thumbnail} alt={other.name} loading="lazy" />}
              <div class="other-card-overlay" aria-hidden="true" />
              <span class="other-card-label">Also see</span>
              <span class="other-card-name">{other.name}</span>
            </a>
          )
        }
      </div>
    </aside>
  </div>

  {
    stay.slug === 'quito-condos' && (
      <section class="location-section" aria-labelledby="location-heading">
        <div class="container location-grid">
          <div class="location-map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3989.7979466466554!2d-78.34976582503542!3d-0.18310329981509224!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMMKwMTAnNTkuMiJTIDc4wrAyMCc0OS45Ilc!5e0!3m2!1ses!2sus!4v1788143456989!5m2!1ses!2sus"
              width="600"
              height="450"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title={`${stay.name}: map location`}
            />
          </div>

          <div class="location-panel">
            <p class="location-eyebrow">Where you'll stay</p>
            <h2 id="location-heading">{stay.location ?? 'Quito, Ecuador'}</h2>
            <div class="location-actions">
              <a
                class="btn btn-primary"
                href="https://www.google.com/maps/search/?api=1&query=-0.18310329981509224,-78.34976582503542"
                target="_blank"
                rel="noopener"
              >
                Get directions
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .stay-hero {
    position: relative;
    height: min(46dvh, 420px);
    overflow: hidden;
    background: var(--sand);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 25, 46, 0.15) 0%, rgba(16, 25, 46, 0.7) 100%);
  }

  .hero-content {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 100%;
    padding-bottom: 2rem;
    color: var(--white);
  }

  .hero-content h1 {
    font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.7rem);
  }

  .hero-meta {
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .stay-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .block {
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .block:first-child {
    border-top: none;
    padding-top: 0;
  }

  .block h2 {
    font-size: var(--text-2xl);
    margin-bottom: 1.25rem;
  }

  .lead-text {
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 68ch;
  }

  .highlight-list {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .highlight-list li {
    padding-left: 1.4rem;
    position: relative;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .highlight-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }

  .amenity-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }

  .amenity-grid li {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    padding-left: 1.4rem;
    position: relative;
  }

  .amenity-grid li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--brand-deep);
    font-weight: 700;
  }

  .rooms-empty {
    padding: 1.75rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .review-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .stay-sidebar {
    position: relative;
  }

  /* Sticky on the wrapper, not the card — sticks the CTA card and the
     "also see" teaser together as one unit, so the teaser scrolls with it
     instead of disappearing under it once the CTA card pins in place. */
  .sidebar-sticky {
    position: sticky;
    top: calc(var(--header-offset) + 1.5rem);
    transition: top 0.35s ease-out;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sidebar-card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.55)),
      url('https://cdn.sanity.io/images/gxkh85js/production/30efb8e889ed291fac0ede8dbdedebaa0d0ce152-1024x1536.webp') center / cover no-repeat,
      var(--white);
    box-shadow: var(--shadow-soft);
  }

  .sidebar-label {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .sidebar-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 640;
    margin-top: 0.3rem;
  }

  .sidebar-meta {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }

  .check-availability {
    width: 100%;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: #ff385c;
    color: var(--white);
    font-weight: 700;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .check-availability:hover {
    background: #e31c5f;
  }

  .check-availability svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .airbnb-logo {
    width: 22px;
    height: 22px;
    display: block;
    flex-shrink: 0;
    filter: brightness(0) invert(1);
  }

  .other-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .other-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale 0.35s ease;
  }

  .other-card:hover img {
    scale: 1.05;
  }

  .other-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0.8) 100%);
  }

  .other-card-label {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .other-card-name {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1.1rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 640;
    line-height: 1.25;
    color: var(--white);
  }

  @media (max-width: 980px) {
    .stay-layout {
      grid-template-columns: 1fr;
    }

    .stay-sidebar {
      order: -1;
    }

    .sidebar-sticky {
      position: static;
    }
  }

  .location-section {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .location-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .location-map {
    position: relative;
    min-height: 320px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--sand);
  }

  .location-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .location-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(16, 25, 46, 0.28) 0%, rgba(16, 25, 46, 0.6) 100%),
      url('/images/quito-panecillo-card.avif') center / cover no-repeat;
    color: var(--white);
  }

  .location-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .location-panel h2 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  .location-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 780px) {
    .location-grid {
      grid-template-columns: 1fr;
    }

    .location-map {
      min-height: 260px;
    }
  }
</style>
