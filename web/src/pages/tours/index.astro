---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToursGrid from '../../components/tours/ToursGrid.astro';
import { getTours, getTourCategories } from '../../lib/content';

const categories = await getTourCategories();
const filters: { slug: string; label: string }[] = [
  { slug: 'all', label: 'All Tours' },
  ...categories.map((c) => ({ slug: c.slug, label: c.name })),
];

const allTours = await getTours();
const counts = Object.fromEntries(
  filters.map((f) => [f.slug, f.slug === 'all' ? allTours.length : allTours.filter((t) => t.category?.slug === f.slug).length]),
);
---

<Base
  title="Galápagos Tours | Galápagos & Beyond"
  description="Day tours, multi-day land packages and diving trips across the Galápagos Islands, expert-guided and ready to book."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tours' }]} />

  <section class="hub-hero">
    <div class="container">
      <p class="eyebrow">Island adventures</p>
      <h1>Galápagos Tours</h1>
      <p class="hub-intro">
        From a single day out to a full week island-hopping, tours run by
        our team on the ground, guided by certified naturalists.
      </p>
    </div>
  </section>

  <section class="hub-list">
    <div class="container">
      <div class="filter-row">
        <div class="filter-bar" role="tablist" aria-label="Filter tours by category" data-tour-filters>
          {
            filters.map((f, i) => (
              <button
                type="button"
                class="filter-btn"
                class:list={{ active: i === 0 }}
                role="tab"
                aria-selected={i === 0}
                data-tour-filter={f.slug}
              >
                {f.label} <span class="filter-count">{counts[f.slug]}</span>
              </button>
            ))
          }
        </div>

        <div class="search-box">
          <input
            type="search"
            name="q"
            placeholder="Search tours…"
            aria-label="Search tours by name or keyword"
            data-tour-search-input
          />
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </div>
      </div>

      <p class="empty" data-tour-empty hidden>No tours match this filter right now.</p>

      <div data-tour-results>
        <ToursGrid />
      </div>

      <nav class="pagination" data-tour-pagination aria-label="Tours pagination" hidden></nav>
    </div>
  </section>
</Base>

<script>
  const PAGE_SIZE = 9;

  const root = document.querySelector<HTMLElement>('[data-tour-filters]');
  const items = document.querySelectorAll<HTMLElement>('[data-tour-item]');
  const emptyMsg = document.querySelector<HTMLElement>('[data-tour-empty]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-tour-search-input]');
  const resultsEl = document.querySelector<HTMLElement>('[data-tour-results]');
  const paginationEl = document.querySelector<HTMLElement>('[data-tour-pagination]');

  let activeCategory = 'all';
  let currentPage = 1;

  // Re-applies category + search filters, then reveals only the slice of
  // matches that falls on `currentPage` — the rest stay in the DOM (so
  // counts/SEO/no-JS are unaffected) but hidden, same trick as the filters
  // themselves.
  function applyFilters(scrollToTop: boolean) {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    const matches: HTMLElement[] = [];

    items.forEach((item) => {
      const matchesCategory = activeCategory === 'all' || item.dataset.category === activeCategory;
      const matchesQuery = query === '' || (item.dataset.tourSearch ?? '').includes(query);
      if (matchesCategory && matchesQuery) matches.push(item);
    });

    const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
    currentPage = Math.min(currentPage, totalPages);

    items.forEach((item) => {
      item.style.display = 'none';
    });
    matches.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE).forEach((item) => {
      item.style.display = '';
    });

    if (emptyMsg) emptyMsg.hidden = matches.length > 0;
    renderPagination(totalPages);

    if (scrollToTop) {
      resultsEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function goToPage(page: number) {
    currentPage = page;
    applyFilters(true);
  }

  function renderPagination(totalPages: number) {
    if (!paginationEl) return;
    paginationEl.hidden = totalPages <= 1;
    if (totalPages <= 1) {
      paginationEl.replaceChildren();
      return;
    }

    const nodes: HTMLElement[] = [];

    const prev = document.createElement('button');
    prev.type = 'button';
    prev.className = 'page-btn page-arrow';
    prev.textContent = 'Prev';
    prev.disabled = currentPage === 1;
    prev.addEventListener('click', () => goToPage(currentPage - 1));
    nodes.push(prev);

    for (let n = 1; n <= totalPages; n += 1) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'page-btn';
      btn.classList.toggle('active', n === currentPage);
      btn.textContent = String(n);
      btn.setAttribute('aria-current', n === currentPage ? 'page' : 'false');
      btn.addEventListener('click', () => goToPage(n));
      nodes.push(btn);
    }

    const next = document.createElement('button');
    next.type = 'button';
    next.className = 'page-btn page-arrow';
    next.textContent = 'Next';
    next.disabled = currentPage === totalPages;
    next.addEventListener('click', () => goToPage(currentPage + 1));
    nodes.push(next);

    paginationEl.replaceChildren(...nodes);
  }

  // Any filter change starts back at page 1 — keeping a stale currentPage
  // would either strand the user mid-list or land them on a page number
  // that no longer exists for the new, smaller result set.
  function resetAndApply() {
    currentPage = 1;
    applyFilters(false);
  }

  root?.querySelectorAll<HTMLButtonElement>('[data-tour-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      root.querySelectorAll<HTMLButtonElement>('[data-tour-filter]').forEach((b) => {
        const active = b === btn;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', String(active));
      });

      activeCategory = btn.dataset.tourFilter ?? 'all';
      resetAndApply();
    });
  });

  searchInput?.addEventListener('input', resetAndApply);

  applyFilters(false);
</script>

<style>
  .hub-hero {
    padding-block: clamp(2.5rem, 6vw, 4rem) 1rem;
    background: var(--sand);
  }

  .hub-hero .eyebrow {
    color: var(--brand-deep);
    margin-bottom: 0.6rem;
  }

  .hub-hero h1 {
    font-size: var(--text-hero);
    max-width: 18ch;
  }

  .hub-intro {
    margin-top: 1.1rem;
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }

  .hub-list {
    background: var(--sand);
    padding-block: 2rem clamp(3rem, 7vw, 5rem);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .search-box {
    position: relative;
    flex: 0 1 260px;
  }

  .search-box input {
    width: 100%;
    padding: 0.6rem 2.5rem 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .search-box input::placeholder {
    color: var(--ink-soft);
  }

  .search-box input:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  /* Search input's native ⌫ clear button (WebKit) sits inside the same
     padding reserved for .search-icon — nudge it left so the two don't
     overlap. */
  .search-box input[type='search']::-webkit-search-cancel-button {
    margin-right: 1.6rem;
  }

  .search-icon {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--ink-soft);
    pointer-events: none;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
  }

  .filter-btn:hover {
    border-color: var(--brand);
    color: var(--brand-deep);
  }

  .filter-btn.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .filter-count {
    font-size: var(--text-xs);
    opacity: 0.75;
  }

  .empty {
    color: var(--ink-soft);
    padding-block: 2rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2.25rem;
  }

  /* :global — these buttons are created client-side via
     document.createElement (page count depends on live filter/search
     results), so they never get Astro's scoped data-astro-cid attribute and
     a plain scoped selector here would silently never match them. */
  :global(.page-btn) {
    min-width: 2.5rem;
    padding: 0.55rem 0.75rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: inherit;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
  }

  :global(.page-btn:hover:not(:disabled)) {
    border-color: var(--brand);
    color: var(--brand-deep);
  }

  :global(.page-btn.active) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  :global(.page-arrow) {
    padding-inline: 1.1rem;
  }

  :global(.page-btn:disabled) {
    opacity: 0.4;
    cursor: default;
  }
</style>
