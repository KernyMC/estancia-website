---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import GalleryTabs from '../../components/ship/GalleryTabs.astro';
import ItineraryTabs from '../../components/ship/ItineraryTabs.astro';
import AvailabilityTable from '../../components/ship/AvailabilityTable.astro';
import RelatedCruises from '../../components/ship/RelatedCruises.astro';
import BookingForm from '../../components/BookingForm.astro';
import { getShip } from '../../lib/content';
import { getDepartures, hasLiveAvailabilityData, formatDateRange, formatPrice } from '../../lib/availability';
import { toParagraphs } from '../../lib/text';
import { productLd } from '../../lib/seo';

const { slug } = Astro.params;
const ship = slug ? await getShip(slug) : undefined;

if (!ship) {
  return Astro.redirect('/cruises/');
}

const departures = await getDepartures(ship);
const nearest = departures[0];
const availabilityDown = departures.length === 0 && !(await hasLiveAvailabilityData());
const descriptionParagraphs = toParagraphs(ship.description);

// Ships without a live-availability API feed (ship.hasLiveAvailability === false)
// never have a `nearest` departure — fall back to the manually-entered indicative
// price so the hero/sidebar still show a number when one was provided.
const heroPrice = nearest?.price ?? (ship.hasLiveAvailability ? undefined : (ship.indicativePrice ?? undefined));

const hubHref = ship.category ? `/cruises/?class=${ship.category.slug}` : '/cruises/';
const shipUrl = `/cruises/${ship.slug}/`;
const catLabel = ship.category?.name ?? '';

// In-page jump links (audit #19) — only for sections that actually render.
const jumpLinks = [
  { label: 'Overview', href: '#about-heading' },
  ship.itineraryRoutes.length > 0 && { label: 'Itinerary', href: '#itinerary-heading' },
  ship.galleryTabs.length > 0 && { label: 'Gallery', href: '#gallery-heading' },
  { label: 'Pricing & dates', href: '#availability' },
  ship.faq.length > 0 && { label: 'FAQ', href: '#faq-heading' },
].filter(Boolean) as Array<{ label: string; href: string }>;

// Product JSON-LD — Offer price only when a real departure is known (never fabricated).
const shipJsonLd = productLd({
  name: `${ship.name}: Galápagos Cruise`,
  description: ship.seo.description || ship.description?.slice(0, 300),
  image: ship.heroImage,
  url: shipUrl,
  category: catLabel ? `${catLabel} Galápagos cruise` : 'Galápagos cruise',
  price: nearest?.price,
});
---

<Base
  title={ship.seo.title || `${ship.name}: ${catLabel ? `${catLabel} ` : ''}Galápagos Cruise`}
  description={ship.seo.description || `${ship.name}, a ${catLabel ? `${catLabel} ` : ''}Galápagos cruise. Live availability and instant booking.`}
  canonical={shipUrl}
  image={ship.heroImage}
  jsonLd={shipJsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Cruises', href: '/cruises/' },
      { label: catLabel, href: hubHref },
      { label: ship.name },
    ]}
  />

  <section class="ship-hero">
    <img src={ship.heroImage} alt={`${ship.name} in the Galápagos Islands`} class="hero-img" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="hero-chip">{catLabel}</span>
      <h1>{ship.name}</h1>
      <p class="hero-meta">{ship.boatType}{nearest ? ` · Next departure ${formatDateRange(nearest.start, nearest.end)}` : ''}</p>
      {
        heroPrice && (
          <p class="hero-price">
            from <strong>{formatPrice(heroPrice)}</strong> / person
          </p>
        )
      }
    </div>
  </section>

  <nav class="jump-nav" aria-label="On this page">
    <div class="container jump-inner">
      <ul class="jump-links">
        {jumpLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
      <a class="jump-hub" href={hubHref}>All {catLabel} cruises</a>
    </div>
  </nav>

  <div class="container ship-layout">
    <div class="ship-main">
      <section class="block" aria-labelledby="about-heading">
        <h2 id="about-heading">What this cruise is</h2>
        {descriptionParagraphs.map((p) => <p class="lead-text">{p}</p>)}

        {
          ship.highlights.length > 0 && (
            <ul class="highlight-list">
              {ship.highlights.map((h) => (
                <li>{h.replace(/^[•\s]+/, '')}</li>
              ))}
            </ul>
          )
        }
      </section>

      {
        ship.itineraryRoutes.length > 0 && (
          <section class="block" aria-labelledby="itinerary-heading">
            <h2 id="itinerary-heading">Day-by-day itinerary</h2>
            <ItineraryTabs routes={ship.itineraryRoutes} />
          </section>
        )
      }

      {
        ship.galleryTabs.length > 0 && (
          <section class="block" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading">Aboard {ship.name}</h2>
            <GalleryTabs tabs={ship.galleryTabs} shipName={ship.name} />
          </section>
        )
      }

      {
        ship.activities.length > 0 && (
          <section class="block" aria-labelledby="activities-heading">
            <h2 id="activities-heading">Onboard activities</h2>
            <ul class="activity-grid">
              {ship.activities.map((a) => (
                <li class="activity-card">
                  {a.main_image && <img src={a.main_image} alt={a.name} loading="lazy" />}
                  <span>{a.name}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="block" id="availability" aria-labelledby="pricing-heading">
        <h2 id="pricing-heading">Pricing and dates</h2>
        {
          ship.hasLiveAvailability ? (
            <>
              <p class="section-sub">Live availability, updated regularly. Prices are per person.</p>
              <AvailabilityTable departures={departures} shipSlug={ship.slug} shipName={ship.name} thumbnail={ship.heroImage} apiDown={availabilityDown} />
            </>
          ) : (
            <>
              <p class="section-sub">This cruise books by request.</p>
              <p class="inquiry-only">
                {ship.indicativePrice ? (
                  <>From <strong>{formatPrice(ship.indicativePrice)}</strong> / person. </>
                ) : null}
                <a href={`/contact/?ship=${ship.slug}`}>Contact us for pricing and dates</a>.
              </p>
            </>
          )
        }
      </section>

      {
        (ship.include.length > 0 || ship.exclude.length > 0) && (
          <section class="block include-exclude">
            {ship.include.length > 0 && (
              <div>
                <h3>Included</h3>
                <ul class="check-list included">
                  {ship.include.map((i) => (
                    <li>{i.replace(/^[•\s]+/, '')}</li>
                  ))}
                </ul>
              </div>
            )}
            {ship.exclude.length > 0 && (
              <div>
                <h3>Not included</h3>
                <ul class="check-list excluded">
                  {ship.exclude.map((i) => (
                    <li>{i.replace(/^[•\s]+/, '')}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )
      }

      <FaqSection faqs={ship.faq} title={`${ship.name}: frequently asked questions`} />

      <p class="hub-backlink">
        Still comparing ships? See all <a href={hubHref}>{catLabel} Galápagos cruises</a> or{' '}
        <a href="/cruises/">the full fleet</a>.
      </p>
    </div>

    <aside class="ship-sidebar">
      <div class="sidebar-card">
        {
          nearest ? (
            <>
              <p class="sidebar-label">From</p>
              <p class="sidebar-price">{formatPrice(nearest.price)}</p>
              <p class="sidebar-meta">per person · {formatDateRange(nearest.start, nearest.end)}</p>
              <BookingForm type="cruise" slug={ship.slug} departureStart={nearest.start} />
            </>
          ) : ship.hasLiveAvailability ? (
            <p class="sidebar-meta">No open departures right now.</p>
          ) : (
            <>
              {ship.indicativePrice && (
                <>
                  <p class="sidebar-label">From</p>
                  <p class="sidebar-price">{formatPrice(ship.indicativePrice)}</p>
                  <p class="sidebar-meta">per person</p>
                </>
              )}
              <a class="btn btn-primary sidebar-cta" href={`/contact/?ship=${ship.slug}`}>Request a custom quote</a>
            </>
          )
        }
        {ship.hasLiveAvailability && <a class="sidebar-link" href="/contact/">Request a custom quote</a>}
      </div>
    </aside>
  </div>

  <RelatedCruises shipSlug={ship.slug} categorySlug={ship.category?.slug} server:defer>
    <section slot="fallback" class="related related-loading" aria-busy="true">
      <div class="container">
        <h2>Other cruises to consider</h2>
        <ul class="related-grid">
          {Array.from({ length: 3 }).map(() => (
            <li class="related-skeleton" aria-hidden="true">
              <div class="skeleton-img" />
              <div class="skeleton-line skeleton-line-lg" />
              <div class="skeleton-line skeleton-line-sm" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </RelatedCruises>
</Base>

<style>
  .ship-hero {
    position: relative;
    height: min(56dvh, 520px);
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 25, 46, 0.15) 0%, rgba(16, 25, 46, 0.75) 100%);
  }

  .hero-content {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 100%;
    padding-bottom: 2.25rem;
    color: var(--white);
  }

  .hero-chip {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3.2rem);
  }

  .hero-meta {
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-price {
    margin-top: 0.4rem;
    font-size: var(--text-lg);
  }

  .hero-price strong {
    font-family: var(--font-display);
    font-size: 1.4em;
  }

  .jump-nav {
    position: sticky;
    top: var(--header-offset);
    transition: top 0.35s ease-out;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .jump-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-block: 0.6rem;
  }

  .jump-hub {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--brand-deep);
    white-space: nowrap;
    margin-left: auto;
  }

  .jump-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .jump-links a {
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--ink-soft);
  }

  .jump-links a:hover {
    color: var(--brand-deep);
  }

  .hub-backlink {
    margin-top: 2rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .hub-backlink a {
    color: var(--brand-deep);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ship-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  /* Grid items default to min-width:auto, not 0 — without this, the
     availability table's min-width: 520px (its own horizontal-scroll
     threshold) pushes this whole column wider than its 1fr track instead
     of scrolling inside .avail-table-wrap, which stretches the entire
     page horizontally on narrow screens. */
  .ship-main {
    min-width: 0;
  }

  .block {
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .block:first-child {
    border-top: none;
    padding-top: 0;
  }

  .block h2 {
    font-size: var(--text-2xl);
    margin-bottom: 1.25rem;
  }

  .section-sub {
    color: var(--ink-soft);
    margin-top: -0.75rem;
    margin-bottom: 1.25rem;
  }

  .inquiry-only {
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-soft);
  }

  .inquiry-only a {
    color: var(--brand-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .inquiry-only strong {
    color: var(--ink);
  }

  .lead-text {
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 68ch;
  }

  .highlight-list {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .highlight-list li {
    padding-left: 1.4rem;
    position: relative;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .highlight-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }

  .activity-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }

  .activity-card {
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .activity-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 0.5rem;
  }

  .include-exclude {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .include-exclude h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.9rem;
  }

  .check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .check-list li {
    padding-left: 1.3rem;
    position: relative;
  }

  .check-list.included li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--brand-deep);
    font-weight: 700;
  }

  .check-list.excluded li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    background: var(--white);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 620;
    font-size: var(--text-sm);
  }

  .faq-answer {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .ship-sidebar {
    position: relative;
  }

  .sidebar-card {
    position: sticky;
    top: calc(var(--header-offset) + 1.5rem);
    transition: top 0.35s ease-out;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.55)),
      url('https://cdn.sanity.io/images/gxkh85js/production/30efb8e889ed291fac0ede8dbdedebaa0d0ce152-1024x1536.webp') center / cover no-repeat,
      var(--white);
    box-shadow: var(--shadow-soft);
  }

  .sidebar-label {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .sidebar-price {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 640;
    line-height: 1.15;
    margin-top: 0.15rem;
  }

  .sidebar-meta {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-top: 0.15rem;
  }

  .sidebar-link {
    display: block;
    text-align: center;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-deep);
  }

  .sidebar-cta {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: 0.75rem;
  }

  .sidebar-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* .related / .related-grid also used by RelatedCruises.astro (server:defer target) — keep in sync. */
  .related {
    background: var(--sand);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .related h2 {
    font-size: var(--text-2xl);
    margin-bottom: 1.75rem;
  }

  .related-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .related-skeleton {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0 0 1.2rem;
    overflow: hidden;
  }

  .skeleton-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--line);
    animation: skeleton-pulse 1.4s ease-in-out infinite;
  }

  .skeleton-line {
    height: 0.85rem;
    margin: 0.9rem 1.1rem 0;
    border-radius: 4px;
    background: var(--line);
    animation: skeleton-pulse 1.4s ease-in-out infinite;
  }

  .skeleton-line-lg {
    width: 70%;
  }

  .skeleton-line-sm {
    width: 45%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 980px) {
    .ship-layout {
      grid-template-columns: 1fr;
    }

    .ship-sidebar {
      order: -1;
    }

    .sidebar-card {
      position: static;
    }

    .include-exclude {
      grid-template-columns: 1fr;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
