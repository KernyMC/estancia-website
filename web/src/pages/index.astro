---
import Base from '../layouts/Base.astro';
import FeaturedCruises from '../components/home/FeaturedCruises.astro';
import FeaturedTours from '../components/home/FeaturedTours.astro';
import StaysAndReviews from '../components/home/StaysAndReviews.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getSocialLinks } from '../lib/content';

const heroImages = [
  'https://cdn.sanity.io/images/gxkh85js/production/e43757e6f8a5cefd16b468ce78cf274421ff8e5a-2400x1350.avif',
  'https://cdn.sanity.io/images/gxkh85js/production/b0df3c3e325838ab7a0e43b43f2f628de7335642-2400x1600.avif',
  'https://cdn.sanity.io/images/gxkh85js/production/0160b0a37b178f74c0f6cf722c7150d2f70bb0d0-2400x1594.avif',
];

const social = await getSocialLinks();

const trustBadges = [
  {
    key: 'airbnb',
    logo: '/images/airbnb-logo.webp',
    stat: '4.86',
    label: 'Airbnb rating',
    href: social?.airbnbUrl,
  },
  {
    key: 'booking',
    logo: '/images/booking-logo.webp',
    stat: '9.6',
    label: 'Booking.com score',
    href: social?.bookingUrl,
  },
  {
    key: 'tripadvisor',
    logo: '/images/trip-advisor-logo.webp',
    stat: 'Featured',
    label: 'on TripAdvisor',
    href: social?.tripadvisorUrl,
  },
] as const;
---

<Base
  title="Luxury Galápagos Cruises & Tours | Galápagos & Beyond"
  description="Small-ship Galápagos cruises with live availability, expert-planned island tours and stays. Ecuador-based specialists. Book online or plan your bespoke trip."
>
  <section class="hero" data-hero-carousel>
    {
      heroImages.map((src, i) => (
        <img
          src={src}
          alt="The Galápagos Islands"
          class="hero-img"
          class:list={{ active: i === 0 }}
          data-hero-slide={i}
          loading="eager"
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      ))
    }
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="container hero-content">
      <p class="eyebrow hero-eyebrow">Ecuador-based Galápagos specialists</p>
      <h1>The Galápagos,<br />planned by people who live it.</h1>
      <p class="hero-sub">
        Small-ship cruises with live availability, expert-guided island tours, and
        places to stay, curated end to end by our team on the islands.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/cruises/">Browse cruises</a>
        <a class="btn btn-ghost" href="/contact/">Plan your trip</a>
      </div>
    </div>
  </section>

  <section class="trust" aria-label="Guest ratings">
    <div class="container trust-inner">
      {
        trustBadges.map((badge) =>
          badge.href ? (
            <a class="trust-item" href={badge.href} target="_blank" rel="noopener noreferrer">
              <span class="trust-logo">
                <img src={badge.logo} alt="" width="56" height="56" loading="lazy" />
              </span>
              <span class="trust-copy">
                <strong>{badge.stat}</strong>
                <span class="trust-label">{badge.label}</span>
              </span>
            </a>
          ) : (
            <span class="trust-item">
              <span class="trust-logo">
                <img src={badge.logo} alt="" width="56" height="56" loading="lazy" />
              </span>
              <span class="trust-copy">
                <strong>{badge.stat}</strong>
                <span class="trust-label">{badge.label}</span>
              </span>
            </span>
          ),
        )
      }
    </div>
  </section>

  <FeaturedCruises />

  <FeaturedTours />

  <StaysAndReviews />

  <WhatsAppButton />
</Base>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero-carousel]');
  const slides = hero?.querySelectorAll<HTMLImageElement>('[data-hero-slide]');
  if (hero && slides && slides.length > 1) {
    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[current].classList.remove('active');
      slides[next].classList.add('active');
      current = next;
    }, 6000);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(88dvh, 780px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero-img.active {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(16, 25, 46, 0.25) 0%, rgba(16, 25, 46, 0.05) 40%, rgba(16, 25, 46, 0.72) 100%);
  }

  .hero-content {
    position: relative;
    color: var(--white);
    padding-block: clamp(3rem, 8vw, 5.5rem);
    max-width: var(--container);
    width: 100%;
  }

  .hero-eyebrow {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: var(--text-hero);
    max-width: 14ch;
  }

  .hero-sub {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.88);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .trust {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.8);
  }

  .trust-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem 6rem;
    padding-block: 2.25rem;
  }

  .trust-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    color: inherit;
    text-align: center;
  }

  a.trust-item {
    transition: opacity 0.2s ease;
  }

  a.trust-item:hover,
  a.trust-item:focus-visible {
    opacity: 0.78;
  }

  .trust-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-logo img {
    width: auto;
    height: 56px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .trust-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.25;
  }

  .trust-copy strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--white);
  }

  .trust-label {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 640px) {
    .trust-inner {
      gap: 1.5rem 3rem;
    }

    .hero-content {
      text-align: center;
    }

    .hero h1,
    .hero-sub {
      max-width: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }
</style>
