---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GalleryTabs from '../../components/ship/GalleryTabs.astro';
import FloorSwitcher from '../../components/stay/FloorSwitcher.astro';
import FaqSection from '../../components/FaqSection.astro';
import ReviewCard from '../../components/reviews/ReviewCard.astro';
import { getStay, getStays, getStayReviews, getSocialLinks, whatsappUrl } from '../../lib/content';
import { toParagraphs } from '../../lib/text';
import { lodgingLd } from '../../lib/seo';

const stay = await getStay('condo-galapagos');

if (!stay) {
  return Astro.redirect('/stays/');
}

const heroImage =
  'https://cdn.sanity.io/images/gxkh85js/production/45420b7dec5d25ed6ce55572c20fdecbd10d2757-1672x941.webp';

const iconStripIcons = [
  {
    src: 'https://cdn.sanity.io/images/gxkh85js/production/dbc2c1f2645101a2bea178fe65b8003d264e0094-200x185.webp',
    alt: 'Comfortable rooms',
    caption: 'Cozy, private bedrooms',
  },
  {
    src: 'https://cdn.sanity.io/images/gxkh85js/production/d3c3880bfa73f9764f53bc0892907570b28e0044-200x185.webp',
    alt: 'Boutique building',
    caption: '5-story boutique building',
  },
  {
    src: 'https://cdn.sanity.io/images/gxkh85js/production/2a8f3e350eaef93beaef245d9b8b5e29f7df6633-200x185.webp',
    alt: 'Pool',
    caption: 'Shared pool, jacuzzi & sauna',
  },
];

const [reviews, social, allStays] = await Promise.all([getStayReviews(stay.slug), getSocialLinks(), getStays()]);
const descriptionParagraphs = toParagraphs(stay.description ?? '');
const other = allStays.find((s) => s.slug !== stay.slug);

const pageUrl = '/condo-galapagos/';
const generalWaHref = social?.whatsappNumber
  ? whatsappUrl(social.whatsappNumber, social.whatsappDefaultMessage ?? `Hi! I'd like to ask about availability at ${stay.name}.`)
  : '/contact/?stay=condo-galapagos';

const jsonLd = lodgingLd({
  name: stay.name,
  description: stay.description ?? undefined,
  image: stay.heroImage ?? undefined,
  url: pageUrl,
  areaServed: stay.location ?? undefined,
});
---

<Base
  title={`${stay.name}${stay.location ? `, ${stay.location}` : ''}`}
  description={`${stay.name}: 5 independent condo apartments in Puerto Ayora, Galápagos, run by the Galápagos & Beyond team.`}
  canonical={pageUrl}
  image={stay.heroImage ?? undefined}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Stays', href: '/stays/' },
      { label: stay.name },
    ]}
  />

  <section class="condo-hero">
    <img src={heroImage} alt={stay.name} class="hero-img" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <p class="hero-eyebrow">Condo Galápagos & Beyond</p>
        <h1>{stay.name}</h1>
        {stay.location && <p class="hero-meta">{stay.location}</p>}
      </div>
    </div>
  </section>

  <section class="icon-strip">
    <div class="container icon-strip-inner">
      {
        iconStripIcons.map((icon) => (
          <div class="icon-strip-item">
            <img src={icon.src} alt={icon.alt} class="icon-strip-img" loading="lazy" />
            <p class="icon-strip-caption">{icon.caption}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    stay.floors.length > 0 && (
      <section class="explore-building" aria-labelledby="explore-heading">
        <div class="container">
          <h2 id="explore-heading" class="explore-heading">Explore the Building</h2>
          <FloorSwitcher floors={stay.floors} stayName={stay.name} />
        </div>
      </section>
    )
  }

  <div class="container condo-layout">
    <div class="condo-main">
      {
        (descriptionParagraphs.length > 0 || stay.highlights.length > 0) && (
          <section class="block" aria-labelledby="about-heading">
            <h2 id="about-heading">About this place</h2>
            {descriptionParagraphs.map((p) => <p class="lead-text">{p}</p>)}

            {stay.highlights.length > 0 && (
              <ul class="highlight-list">
                {stay.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      {
        stay.amenities.length > 0 && (
          <section class="block" aria-labelledby="amenities-heading">
            <h2 id="amenities-heading">Building amenities</h2>
            <p class="section-sub">Shared by all five condos.</p>
            <ul class="amenity-grid">
              {stay.amenities.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        stay.gallery.length > 0 && (
          <section class="block" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading">Photos</h2>
            <GalleryTabs tabs={stay.gallery} shipName={stay.name} />
          </section>
        )
      }

      {
        reviews.length > 0 && (
          <section class="block" aria-labelledby="reviews-heading">
            <h2 id="reviews-heading">What guests say</h2>
            <ul class="review-list">
              {reviews.map((r) => (
                <ReviewCard review={r} />
              ))}
            </ul>
          </section>
        )
      }

      <FaqSection faqs={stay.faq} />
    </div>

    <aside class="condo-sidebar">
      <div class="sidebar-sticky">
        <div class="sidebar-card">
          <p class="sidebar-label">Interested?</p>
          <p class="sidebar-title">{stay.name}</p>
          {stay.location && <p class="sidebar-meta">{stay.location}</p>}
          <a class="btn btn-primary sidebar-cta" href={generalWaHref} target="_blank" rel="noopener">
            Ask about availability
          </a>
          <p class="sidebar-hint">Opens WhatsApp with your message ready to send.</p>
        </div>

        {
          other && (
            <a class="other-card" href={other.slug === 'condo-galapagos' ? '/condo-galapagos/' : `/stays/${other.slug}/`}>
              {other.thumbnail && <img src={other.thumbnail} alt={other.name} loading="lazy" />}
              <div class="other-card-overlay" aria-hidden="true" />
              <span class="other-card-label">Also see</span>
              <span class="other-card-name">{other.name}</span>
            </a>
          )
        }
      </div>
    </aside>
  </div>

  <section class="location-section" aria-labelledby="location-heading">
    <div class="container location-grid">
      <div class="location-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.4812863678612!2d-90.31916842431288!3d-0.744733635275515!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9aaa5de1317d7449%3A0x614ce96eb374afff!2sGalapagos%20and%20Beyond!5e0!3m2!1ses!2sec!4v1785511172434!5m2!1ses!2sec"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={`${stay.name}: map location`}
        />
      </div>

      <div class="location-panel">
        <p class="location-eyebrow">Where you'll stay</p>
        <h2 id="location-heading">{stay.location ?? 'Puerto Ayora, Santa Cruz'}</h2>
        <p class="location-copy">
          Steps from the Galápagos National Park entrance, the dock and Puerto Ayora's restaurants, with Tortuga Bay a short walk away.
        </p>
        <div class="location-actions">
          <a
            class="btn btn-primary"
            href="https://www.google.com/maps/search/?api=1&query=Galapagos+and+Beyond+Puerto+Ayora"
            target="_blank"
            rel="noopener"
          >
            Get directions
          </a>
          <a class="location-whatsapp" href={generalWaHref} target="_blank" rel="noopener">
            Message us on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .condo-hero {
    position: relative;
    height: min(56dvh, 520px);
    overflow: hidden;
    background: var(--sand);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(16, 25, 46, 0.35) 0%, rgba(16, 25, 46, 0.15) 30%, rgba(16, 25, 46, 0.1) 55%, rgba(16, 25, 46, 0.55) 100%),
      linear-gradient(270deg, rgba(16, 25, 46, 0.15) 0%, rgba(16, 25, 46, 0.1) 45%, rgba(10, 16, 30, 0.75) 100%);
  }

  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-block: 2rem;
  }

  .hero-text {
    max-width: 22rem;
    text-align: left;
    color: var(--white);
  }

  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .hero-text h1 {
    margin-top: 0.4rem;
    font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.7rem);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }

  .hero-meta {
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .icon-strip {
    background: var(--ink);
  }

  .icon-strip-inner {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: 1.75rem;
  }

  .icon-strip-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    max-width: 10rem;
    text-align: center;
    margin-inline: auto;
  }

  .icon-strip-img {
    width: clamp(36px, 4.5vw, 46px);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .icon-strip-caption {
    width: 100%;
    font-size: var(--text-xs);
    font-weight: 620;
    color: var(--white);
    line-height: 1.4;
    text-align: center;
  }

  .condo-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    padding-top: clamp(3.5rem, 7vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .block {
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .block:first-child {
    border-top: none;
    padding-top: 0;
  }

  .block h2 {
    font-size: var(--text-2xl);
  }

  .section-sub {
    margin-top: 0.3rem;
    margin-bottom: 1.25rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .lead-text {
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 68ch;
  }

  .highlight-list {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .highlight-list li {
    padding-left: 1.4rem;
    position: relative;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .highlight-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }

  .amenity-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .amenity-grid li {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    padding-left: 1.4rem;
    position: relative;
  }

  .amenity-grid li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--brand-deep);
    font-weight: 700;
  }

  .explore-building {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .explore-heading {
    position: relative;
    text-align: center;
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.4rem);
    padding-bottom: 1.1rem;
    margin-bottom: 2rem;
  }

  .explore-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 3rem;
    height: 3px;
    border-radius: 999px;
    background: var(--brand);
  }

  .review-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }


  .condo-sidebar {
    position: relative;
  }

  /* Sticky on the wrapper, not the card — sticks the CTA card and the
     "also see" teaser together as one unit, so the teaser scrolls with it
     instead of disappearing under it once the CTA card pins in place. */
  .sidebar-sticky {
    position: sticky;
    top: calc(var(--header-offset) + 1.5rem);
    transition: top 0.35s ease-out;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sidebar-card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.55)),
      url('https://cdn.sanity.io/images/gxkh85js/production/30efb8e889ed291fac0ede8dbdedebaa0d0ce152-1024x1536.webp') center / cover no-repeat,
      var(--white);
    box-shadow: var(--shadow-soft);
  }

  .sidebar-label {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .sidebar-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 640;
    margin-top: 0.3rem;
  }

  .sidebar-meta {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }

  .sidebar-cta {
    width: 100%;
    justify-content: center;
    margin-top: 1.25rem;
  }

  .sidebar-hint {
    margin-top: 0.6rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-align: center;
  }

  .other-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .other-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale 0.35s ease;
  }

  .other-card:hover img {
    scale: 1.05;
  }

  .other-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0.8) 100%);
  }

  .other-card-label {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .other-card-name {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1.1rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 640;
    line-height: 1.25;
    color: var(--white);
  }

  .location-section {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .location-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .location-map {
    position: relative;
    min-height: 320px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--sand);
  }

  .location-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .location-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(16, 25, 46, 0.28) 0%, rgba(16, 25, 46, 0.6) 100%),
      url('/images/galapagos-puerto-ayora-card.avif') center / cover no-repeat;
    color: var(--white);
  }

  .location-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .location-panel h2 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  .location-copy {
    margin-top: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.65;
    font-size: var(--text-sm);
    max-width: 40ch;
  }

  .location-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .location-whatsapp {
    font-size: var(--text-sm);
    font-weight: 620;
    color: var(--white);
  }

  .location-whatsapp:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 780px) {
    .location-grid {
      grid-template-columns: 1fr;
    }

    .location-map {
      min-height: 260px;
    }
  }

  @media (max-width: 980px) {
    .condo-layout {
      grid-template-columns: 1fr;
    }

    .condo-sidebar {
      order: -1;
    }

    .sidebar-sticky {
      position: static;
    }

    .hero-content {
      justify-content: center;
      padding-inline: 1.25rem;
    }

    .hero-text {
      max-width: none;
      text-align: center;
    }
  }
</style>
