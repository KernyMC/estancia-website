---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
}

const { title, heading, description } = Astro.props;
---

<Base title={title} description={description}>
  <section class="placeholder">
    <div class="container">
      <p class="eyebrow">Coming together</p>
      <h1>{heading}</h1>
      <p class="placeholder-sub">{description}</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .placeholder {
    padding-block: clamp(4rem, 12vw, 8rem);
    background: var(--sand);
  }

  .placeholder h1 {
    font-size: var(--text-2xl);
    margin-block: 0.75rem 1rem;
  }

  .placeholder-sub {
    color: var(--ink-soft);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .placeholder .eyebrow {
    color: var(--brand-deep);
  }
</style>
