---
import { getSocialLinks, whatsappUrl } from '../lib/content';

const social = await getSocialLinks();
const href = social?.whatsappNumber
  ? whatsappUrl(social.whatsappNumber, social.whatsappDefaultMessage ?? 'Hola, quisiera más información')
  : null;
---

{href && (
  <a class="whatsapp-fab" href={href} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp">
    <img src="/images/blue-footed-boobie-normal.webp" alt="" class="whatsapp-fab-img whatsapp-fab-img--normal" />
    <img src="/images/blue-footed-boobie-pressed.webp" alt="" class="whatsapp-fab-img whatsapp-fab-img--pressed" />
  </a>
)}

<style>
  .whatsapp-fab {
    position: fixed;
    right: clamp(1rem, 4vw, 1.75rem);
    bottom: clamp(1rem, 4vw, 1.75rem);
    z-index: var(--z-whatsapp);
    width: 64px;
    height: 64px;
    display: block;
    filter: drop-shadow(var(--shadow-soft));
    transition: transform 0.2s ease;
    animation: whatsapp-glow 3.2s ease-in-out infinite;
  }

  @keyframes whatsapp-glow {
    0%, 100% {
      filter: drop-shadow(var(--shadow-soft));
    }
    50% {
      filter: drop-shadow(var(--shadow-soft)) drop-shadow(0 0 10px rgba(255, 255, 255, 0.35));
    }
  }

  .whatsapp-fab:hover,
  .whatsapp-fab:focus-visible {
    transform: scale(1.06);
  }

  .whatsapp-fab-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s ease;
  }

  .whatsapp-fab-img--normal {
    opacity: 1;
  }

  .whatsapp-fab-img--pressed {
    opacity: 0;
  }

  .whatsapp-fab:hover .whatsapp-fab-img--normal,
  .whatsapp-fab:focus-visible .whatsapp-fab-img--normal {
    opacity: 0;
  }

  .whatsapp-fab:hover .whatsapp-fab-img--pressed,
  .whatsapp-fab:focus-visible .whatsapp-fab-img--pressed {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .whatsapp-fab {
      width: 56px;
      height: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
    }
  }
</style>
