---
import { getSocialLinks, getCruiseClasses, getTourCategories } from '../lib/content';

const year = new Date().getFullYear();
const [social, cruiseClasses, tourCategories] = await Promise.all([
  getSocialLinks(),
  getCruiseClasses(),
  getTourCategories(),
]);

const emails = [social?.email, social?.personalEmail].filter(
  (value): value is string => Boolean(value),
);

const socialIcons = [
  social?.instagramUrl && { label: 'Instagram', href: social.instagramUrl, icon: 'instagram' as const },
  social?.facebookUrl && { label: 'Facebook', href: social.facebookUrl, icon: 'facebook' as const },
  social?.tripadvisorUrl && { label: 'TripAdvisor', href: social.tripadvisorUrl, icon: 'tripadvisor' as const },
  social?.airbnbUrl && { label: 'Airbnb', href: social.airbnbUrl, icon: 'airbnb' as const },
  social?.bookingUrl && { label: 'Booking.com', href: social.bookingUrl, icon: 'booking' as const },
].filter(
  (
    value,
  ): value is {
    label: string;
    href: string;
    icon: 'instagram' | 'facebook' | 'tripadvisor' | 'airbnb' | 'booking';
  } => Boolean(value),
);

const columns = [
  {
    title: 'Cruises',
    links: [
      { label: 'All Cruises', href: '/cruises/' },
      ...cruiseClasses.map((c) => ({ label: c.name, href: `/cruises/?class=${c.slug}` })),
    ],
  },
  {
    title: 'Tours',
    links: [
      { label: 'All Tours', href: '/tours/' },
      ...tourCategories.map((c) => ({ label: c.name, href: `/tours/${c.slug}/` })),
    ],
  },
  {
    title: 'Stays',
    links: [
      { label: 'Condo Galápagos', href: '/condo-galapagos/' },
      { label: 'Quito Condo', href: '/stays/quito-condos/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Travel Guide', href: '/guide/' },
      { label: 'FAQ', href: '/faq/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand-mark" href="/">
        <img class="brand-logo" src="/logos/galapagosandbeyond-logo.svg" alt="Galápagos & Beyond" width="44" height="44" />
        <p class="brand-name">Galápagos <em>&amp;</em> Beyond</p>
      </a>
      <p class="footer-tagline">
        Ecuador-based specialists in Galápagos cruises, island tours and stays.
      </p>

      {
        emails.length > 0 && (
          <ul class="footer-emails">
            {emails.map((email) => (
              <li>
                <a href={`mailto:${email}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                    <path d="m3 6.5 9 6.5 9-6.5" />
                  </svg>
                  <span>{email}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        socialIcons.length > 0 && (
          <ul class="footer-social" aria-label="Social media">
            {socialIcons.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-label={item.label}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.icon === 'instagram' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                      <circle cx="12" cy="12" r="4.5" />
                      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {item.icon === 'facebook' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 8.5h2V5h-2.5A3.5 3.5 0 0 0 11 8.5V11H9v3h2v6.5h3V14h2.4l.6-3h-3v-2a1 1 0 0 1 1-.5Z" />
                    </svg>
                  )}
                  {item.icon === 'tripadvisor' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="7.5" cy="14" r="3.5" />
                      <circle cx="16.5" cy="14" r="3.5" />
                      <path d="M11 12a1.5 1.5 0 0 1 2 0" />
                      <path d="M2 8h5.2M16.8 8H22M9.5 8c-2.5 0-4.6 1.2-5.9 3M14.5 8c2.5 0 4.6 1.2 5.9 3" />
                    </svg>
                  )}
                  {item.icon === 'airbnb' && (
                    <img class="icon-mono" src="/logos/air-bnb-logo.svg" alt="" width="18" height="18" loading="lazy" />
                  )}
                  {item.icon === 'booking' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M8 5v14h5.5a3.5 3.5 0 0 0 0-7H8m0 0h5a3 3 0 0 0 0-6H8" />
                      <circle cx="17" cy="18.5" r="1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  <span class="visually-hidden">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="footer-columns">
      {
        columns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <p class="footer-heading">{col.title}</p>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="footer-scene" role="presentation"></div>

  <div class="container footer-legal">
    <p>© {year} Galápagos &amp; Beyond. All rights reserved.</p>
    <nav class="footer-legal-links" aria-label="Legal">
      <a href="/terms/">Terms &amp; Conditions</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/cookies/">Cookie Policy</a>
    </nav>
  </div>

  <p class="footer-credit">
    made by <a href="https://kernixstudios.com/" target="_blank" rel="noopener noreferrer">kernixstudios.com</a>
  </p>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.85);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 3rem;
    padding-block: 3.5rem 2.5rem;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-logo {
    height: 40px;
    width: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--white);
    padding: 3px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 620;
    color: var(--white);
  }

  .brand-name em {
    color: var(--brand);
    font-style: italic;
  }

  .footer-tagline {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    max-width: 28ch;
  }

  .footer-emails {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-emails a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.82);
  }

  .footer-emails a:hover {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-emails svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-social {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    gap: 0.6rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.82);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .footer-social svg {
    width: 18px;
    height: 18px;
  }

  .footer-social a:hover,
  .footer-social a:focus-visible {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--white);
  }

  /* Airbnb/Booking marks drawn the same way as Instagram/Facebook/TripAdvisor:
     same outline circle, same footer-colored background, icon in white. */
  .footer-social img.icon-mono {
    width: 18px;
    height: 18px;
    filter: brightness(0) invert(1);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.82);
  }

  .footer-col a:hover {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-scene {
    width: 100%;
    aspect-ratio: 2103 / 350;
    background-image: url('/images/bg-gap.png');
    background-repeat: no-repeat;
    background-position: bottom center;
    background-size: 100% 100%;
  }

  .footer-legal {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 1.25rem;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-legal-links a {
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-legal-links a:hover {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-credit {
    text-align: center;
    padding-block: 0.75rem;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-credit a {
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-credit a:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 800px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .footer-brand {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .footer-tagline {
      max-width: 32ch;
    }

    .footer-social {
      justify-content: center;
    }

    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }

    .footer-legal {
      justify-content: center;
      text-align: center;
    }
  }
</style>
