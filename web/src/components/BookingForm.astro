---
/**
 * Booking form. Two payment paths from the same fields:
 *   - Stripe: submit → POST /api/checkout → redirect to Stripe's hosted page.
 *   - PayPal: inline SDK v6 button → POST /api/paypal/create-order →
 *     buyer approves in the widget → POST /api/paypal/capture-order.
 *
 * The price is NEVER sent from here — the server recalculates it from the
 * slug (+ departure for cruises). For cruises, the hidden departure-start
 * input is populated by the opener (see AvailabilityTable) before showing.
 *
 * PayPal buttons only render when PUBLIC_PAYPAL_CLIENT_ID is set (see
 * server/env.ts — same "absent adapter is safe" pattern as SMTP email).
 */
import { env, paypalConfigured } from '../server/env';
import { formatPrice } from '../lib/availability';
import { countryCodes, defaultCountry } from '../lib/phone-codes';
import type { TourAddOn } from '../lib/content';
import type { SeasonalPrice } from '../lib/seasonal-pricing';

interface Props {
  type: 'tour' | 'cruise';
  slug: string;
  /** Cruise only — fixed departure, set by the opener (AvailabilityTable) via JS. */
  departureStart?: string;
  /** Tour only — paid activity variants (e.g. snorkeling vs a diving upgrade). */
  addOns?: TourAddOn[];
  /** Tour only — current/upcoming seasonal prices, so the displayed price follows the chosen start date (hint only; the server prices). */
  seasons?: SeasonalPrice[];
}

const { type, slug, departureStart, addOns, seasons } = Astro.props;
const todayIso = new Date().toISOString().slice(0, 10);

// Read through server/env (process.env) and NOT import.meta.env: Vite
// replaces import.meta.env statically at build time, so in a container the
// buttons would be frozen to whatever the builder had — the runtime env
// injected by Dokploy would never be seen. Same reason the client ID reaches
// the browser as a data attribute instead of an inlined constant.
const paypalClientId = env.PUBLIC_PAYPAL_CLIENT_ID;
const paypalEnv = env.PAYPAL_ENV;
const paypalReady = paypalConfigured;
---

<form
  class="booking-form"
  data-booking-form
  data-seasons={seasons && seasons.length > 0 ? JSON.stringify(seasons) : undefined}
>
  <input type="hidden" name="type" value={type} />
  <input type="hidden" name="slug" value={slug} />
  {
    type === 'cruise' && (
      <input type="hidden" name="departureStart" value={departureStart ?? ''} data-departure-start />
    )
  }

  {
    type === 'tour' && (
      <div class="field-row">
        <label class="field">
          <span>Start date</span>
          <span class="date-input-wrap">
            <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M3 10h18M8 2v4M16 2v4" />
            </svg>
            <input type="date" name="departureStart" required min={todayIso} data-tour-start />
          </span>
        </label>
        <label class="field">
          <span>End date</span>
          <span class="date-input-wrap">
            <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M3 10h18M8 2v4M16 2v4" />
            </svg>
            <input type="date" name="departureEnd" required min={todayIso} data-tour-end />
          </span>
        </label>
      </div>
    )
  }

  <div class="field-row">
    <label class="field">
      <span>Adults</span>
      <input type="number" name="adults" inputmode="numeric" min="1" max="8" step="1" value="1" required />
    </label>
    <label class="field">
      <span>Children</span>
      <input type="number" name="children" inputmode="numeric" min="0" max="6" step="1" value="0" required />
    </label>
  </div>

  {
    addOns && addOns.length > 0 && (
      <fieldset class="field addon-field" data-addon-field data-addons={JSON.stringify(addOns)}>
        <legend>Activity</legend>
        <label class="addon-option">
          <input type="radio" name="addOnSlug" value="" checked />
          <span>{addOns[0]?.replaces ? `Included: ${addOns[0].replaces}` : 'Included'}</span>
        </label>
        {addOns.map((addOn) => (
          <label class="addon-option">
            <input type="radio" name="addOnSlug" value={addOn.slug} />
            <span>
              {addOn.name} <em>(+{formatPrice(addOn.priceDelta)}/person)</em>
            </span>
          </label>
        ))}
      </fieldset>
    )
  }

  <label class="field">
    <span>Full name</span>
    <input type="text" name="name" required maxlength="200" autocomplete="name" />
  </label>

  <label class="field">
    <span>Email</span>
    <input type="email" name="email" required maxlength="320" autocomplete="email" />
  </label>

  <label class="field">
    <span>Phone <em>(optional)</em></span>
    <div class="phone-row">
      <div class="phone-code-picker" data-phone-picker>
        <button type="button" class="phone-code-btn" data-phone-btn aria-haspopup="listbox" aria-expanded="false">
          <img class="phone-flag" data-phone-flag src={`https://flagcdn.com/${defaultCountry.iso}.svg`} alt="" width="20" height="15" />
          <span data-phone-dial>{defaultCountry.dial}</span>
          <svg class="phone-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div class="phone-code-panel" data-phone-panel hidden>
          <input
            type="text"
            class="phone-code-search"
            data-phone-search
            placeholder="Search country…"
            autocomplete="off"
            aria-label="Search country"
          />
          <ul class="phone-code-list" data-phone-list role="listbox">
            {countryCodes.map((c) => (
              <li role="option" data-dial={c.dial} data-iso={c.iso} data-name={c.name} data-search={`${c.name} ${c.dial}`.toLowerCase()} tabindex="-1">
                <img src={`https://flagcdn.com/${c.iso}.svg`} alt="" width="20" height="15" loading="lazy" />
                <span class="phone-opt-name">{c.name}</span>
                <span class="phone-opt-dial">{c.dial}</span>
              </li>
            ))}
          </ul>
          <p class="phone-code-empty" data-phone-empty hidden>No matches</p>
        </div>
        <input type="hidden" name="phoneCode" value={defaultCountry.dial} data-phone-input />
      </div>
      <input type="tel" name="phone" maxlength="30" autocomplete="tel-national" placeholder="99 123 4567" />
    </div>
  </label>

  <p class="form-error" data-form-error hidden></p>

  {
    paypalReady && (
      <div class="alt-payment" data-paypal-section={paypalEnv} data-paypal-client-id={paypalClientId}>
        <p class="paypal-loading" data-paypal-loading>
          <span class="paypal-spinner" aria-hidden="true" />
          Loading payment options…
        </p>
        <div class="paypal-buttons" data-paypal-buttons hidden>
          <paypal-button hidden data-paypal-btn />
        </div>
      </div>
    )
  }

  <button
    type="submit"
    class:list={['btn', 'submit-btn', paypalReady ? 'btn-card' : 'btn-primary']}
    data-submit-btn
  >
    {
      paypalReady && (
        <svg class="btn-icon" data-submit-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="5" width="20" height="14" rx="2" />
          <line x1="2" y1="10" x2="22" y2="10" />
        </svg>
      )
    }
    <span data-submit-label>{paypalReady ? 'Pay with card' : 'Continue to secure payment'}</span>
  </button>
  <p class="secure-note">
    Payments processed securely by Stripe{paypalReady ? ' or PayPal' : ''}.
  </p>
</form>

<script>
  import { startStripeCheckout, mountPaypalButtons, type CheckoutPayload } from '../scripts/checkout-client';
  import { wirePhoneCodePicker, buildPhoneValue } from '../scripts/phone-code-picker';
  import { resolveTourPrice, isIsoDate, type SeasonalPrice } from '../lib/seasonal-pricing';

  // A direct "Book now" purchase is a cart of exactly one item — there is
  // only one checkout code path (see src/pages/api/checkout.ts).
  function buildPayload(form: HTMLFormElement): CheckoutPayload {
    const data = new FormData(form);
    const type = data.get('type') as 'tour' | 'cruise';
    const addOnSlug = data.get('addOnSlug') as string | null;
    return {
      items: [
        {
          type,
          slug: data.get('slug') as string,
          adults: Number(data.get('adults')),
          children: Number(data.get('children')),
          ...(type === 'cruise' ? { departureStart: data.get('departureStart') as string } : {}),
          ...(type === 'tour'
            ? {
                departureStart: data.get('departureStart') as string,
                departureEnd: data.get('departureEnd') as string,
              }
            : {}),
          ...(type === 'tour' && addOnSlug ? { addOnSlug } : {}),
        },
      ],
      customer: {
        name: data.get('name') as string,
        email: data.get('email') as string,
        phone: buildPhoneValue(data),
      },
    };
  }

  interface AddOn {
    slug: string;
    name: string;
    priceDelta: number;
  }

  /** Same rounding/format as lib/availability.ts formatPrice — kept local so this script never imports server code. */
  function formatUsd(value: number): string {
    return `$${Math.round(value).toLocaleString('en-US')}`;
  }

  /**
   * Keeps the sidebar/dialog price in step with the chosen start date and
   * add-on. Display hint only — the amount charged is always recomputed on the
   * server (server/pricing/pricing.ts) with this same resolver.
   */
  function wireTourPriceSync(form: HTMLFormElement): void {
    const priceEl = document.querySelector<HTMLElement>('[data-sidebar-price]');
    if (!priceEl) return;

    const addonField = form.querySelector<HTMLElement>('[data-addon-field]');
    const seasons: SeasonalPrice[] = JSON.parse(form.dataset.seasons ?? '[]');
    if (!addonField && seasons.length === 0) return;

    const addOns: AddOn[] = JSON.parse(addonField?.dataset.addons ?? '[]');
    const startInput = form.querySelector<HTMLInputElement>('[data-tour-start]');
    const labelEl = document.querySelector<HTMLElement>('[data-sidebar-label]');
    const seasonNoteEl = document.querySelector<HTMLElement>('[data-sidebar-season-note]');
    const addonNoteEl = document.querySelector<HTMLElement>('[data-sidebar-addon-note]');
    const dialogPriceEl = document.querySelector<HTMLElement>('[data-dialog-price]');
    const basePrice = priceEl.dataset.basePrice ? Number(priceEl.dataset.basePrice) : null;
    const fromPrice = Number(priceEl.dataset.fromPrice ?? basePrice);

    function update() {
      const date = startInput?.value;
      const dated = seasons.length > 0 && isIsoDate(date);
      const resolved = resolveTourPrice({ price: basePrice, childPrice: null, seasonalPrices: seasons }, date);
      const unit = dated && resolved.price != null ? resolved.price : fromPrice;

      const selected = form.querySelector<HTMLInputElement>('input[name="addOnSlug"]:checked');
      const addOn = addOns.find((a) => a.slug === selected?.value);
      priceEl!.textContent = formatUsd(unit + (addOn?.priceDelta ?? 0));
      if (dialogPriceEl) dialogPriceEl.textContent = `${formatUsd(unit)} / person`;

      if (labelEl && seasons.length > 0) {
        labelEl.textContent = dated && resolved.price != null ? 'Your dates' : 'From';
      }
      if (seasonNoteEl) {
        if (dated) {
          seasonNoteEl.textContent =
            resolved.price == null
              ? 'Not available online for these dates — please contact us.'
              : (resolved.season?.label ?? (resolved.season ? 'Seasonal price' : 'Standard price'));
          seasonNoteEl.hidden = false;
        } else {
          seasonNoteEl.hidden = true;
        }
      }
      if (addonNoteEl) {
        if (addOn) {
          addonNoteEl.textContent = `+ ${formatUsd(addOn.priceDelta)} ${addOn.name}`;
          addonNoteEl.hidden = false;
        } else {
          addonNoteEl.hidden = true;
        }
      }
    }

    for (const radio of addonField?.querySelectorAll('input[name="addOnSlug"]') ?? []) {
      radio.addEventListener('change', update);
    }
    startInput?.addEventListener('input', update);
    startInput?.addEventListener('change', update);
  }

  function wireTourDateSync(form: HTMLFormElement): void {
    const start = form.querySelector<HTMLInputElement>('[data-tour-start]');
    const end = form.querySelector<HTMLInputElement>('[data-tour-end]');
    if (!start || !end) return;
    start.addEventListener('change', () => {
      end.min = start.value || end.min;
      if (end.value && end.value < start.value) end.value = start.value;
    });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-booking-form]')) {
    const errorEl = form.querySelector<HTMLElement>('[data-form-error]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit-btn]')!;
    wireTourPriceSync(form);
    wireTourDateSync(form);
    wirePhoneCodePicker(form);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      const labelEl = submitBtn.querySelector<HTMLElement>('[data-submit-label]');
      const iconEl = submitBtn.querySelector<HTMLElement>('[data-submit-icon]');
      const idleLabel = labelEl?.textContent ?? '';

      submitBtn.disabled = true;
      if (iconEl) iconEl.hidden = true;
      if (labelEl) labelEl.textContent = 'Preparing checkout…';
      const failure = await startStripeCheckout(buildPayload(form));
      if (failure) {
        errorEl.textContent = failure.error;
        errorEl.hidden = false;
        submitBtn.disabled = false;
        if (iconEl) iconEl.hidden = false;
        if (labelEl) labelEl.textContent = idleLabel;
      }
      // On success startStripeCheckout already redirected — nothing left to do.
    });

    const paypalSection = form.querySelector<HTMLElement>('[data-paypal-section]');
    if (paypalSection) {
      mountPaypalButtons({
        section: paypalSection,
        buildPayload: () => {
          // reportValidity() surfaces native "required" hints (name/email)
          // even though this isn't a submit button.
          if (!form.reportValidity()) return null;
          return buildPayload(form);
        },
        onError: (message) => {
          errorEl.textContent = message;
          errorEl.hidden = false;
        },
      });
    }
  }
</script>

<style>
  .booking-form {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.5rem;
    min-width: 0;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
    min-width: 0;
  }

  .field {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-sm);
    min-width: 0;
  }

  /* Direct-child only — a descendant selector here also caught the addon
     radio labels and the phone-picker's country-list spans, uppercasing and
     bold-ing text that was never meant to look like a field label (found
     2026-08-02, screenshot showed "INCLUDED" instead of "Included"). The
     :not() exclusion is the same fix for the tour date fields' wrapping
     <span class="date-input-wrap"> — also a direct child of .field, so
     without it the date value itself rendered bold/uppercase too (found
     2026-09-24). */
  .field > span:not(.date-input-wrap) {
    font-weight: 600;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .field em {
    font-style: normal;
    text-transform: none;
    font-weight: 400;
  }

  .addon-field {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.7rem 0.8rem;
    display: grid;
    gap: 0.5rem;
  }

  .addon-field legend {
    font-weight: 600;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    padding: 0;
  }

  .addon-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }

  .addon-option input {
    accent-color: var(--brand);
  }

  .addon-option em {
    font-style: normal;
    color: var(--ink-soft);
  }

  /* :not(radio) rather than a direct-child restriction — the phone number
     input (nested inside .phone-row, a grandchild of .field) still needs
     this border/padding/background, but the addon <input type="radio">
     doesn't: as a plain descendant selector it stretched to width:100% and
     shoved its label far to the right (found 2026-08-02). */
  .field input:not([type='radio']):not([type='date']),
  .field select {
    width: 100%;
    min-width: 0;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
    background: var(--white);
  }

  .field input:not([type='radio']):not([type='date']):focus-visible,
  .field select:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  /* Native date inputs render an unstyled system calendar icon that clashes
     with the rest of the form — same box treatment as the icon-prefixed date
     fields in AvailabilityTable, for visual consistency. */
  .date-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.35rem 0.65rem;
    background: var(--white);
  }

  .date-input-wrap:focus-within {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .date-icon {
    width: 15px;
    height: 15px;
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .date-input-wrap input[type='date'] {
    width: 100%;
    min-width: 0;
    border: none;
    padding: 0;
    background: transparent;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .date-input-wrap input[type='date']:focus {
    outline: none;
  }

  .phone-row {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
  }

  .phone-row input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .phone-code-picker {
    position: relative;
    flex: 0 0 auto;
  }

  .phone-code-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    height: 100%;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }

  .phone-code-btn:hover {
    border-color: var(--ink-soft);
  }

  .phone-code-btn:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .phone-flag {
    width: 18px;
    height: 13px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .phone-chevron {
    width: 12px;
    height: 12px;
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .phone-code-panel {
    position: absolute;
    top: calc(100% + 0.3rem);
    left: 0;
    z-index: 10;
    width: 240px;
    max-width: 80vw;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-soft);
  }

  .phone-code-panel[hidden] {
    display: none;
  }

  .phone-code-search {
    width: 100%;
    padding: 0.45rem 0.6rem;
    margin-bottom: 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--text-sm);
  }

  .phone-code-search:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .phone-code-list {
    max-height: 220px;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .phone-code-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: calc(var(--radius) - 4px);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .phone-code-list li[hidden] {
    display: none;
  }

  .phone-code-list li:hover,
  .phone-code-list li:focus-visible {
    background: var(--sand);
  }

  .phone-code-list img {
    width: 20px;
    height: 15px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .phone-opt-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .phone-opt-dial {
    color: var(--ink-soft);
    font-size: var(--text-xs);
  }

  .phone-code-empty {
    margin: 0.4rem 0 0.1rem;
    padding: 0.3rem 0.5rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-align: center;
  }

  .phone-code-empty[hidden] {
    display: none;
  }

  .form-error {
    color: #b3261e;
    font-size: var(--text-sm);
    margin: 0;
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    padding-block: 0.65rem;
  }

  .btn-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #635bff;
    color: var(--white);
    border-color: #635bff;
  }

  .btn-card:hover {
    background: #4f47e0;
    border-color: #4f47e0;
  }

  .btn-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .secure-note {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin: 0;
  }

  .alt-payment {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
  }

  .paypal-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    height: 2.5rem;
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .paypal-loading[hidden] {
    display: none;
  }

  .paypal-spinner {
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--line);
    border-top-color: var(--brand);
    border-radius: 50%;
    animation: paypal-spin 0.7s linear infinite;
  }

  @keyframes paypal-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .paypal-buttons {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    justify-items: center;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .paypal-buttons.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .alt-payment paypal-button {
    display: block;
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .paypal-spinner {
      animation-duration: 1.4s;
    }

