---
import { getShips, getFeaturedShipSlugs, type Ship } from '../../lib/content';
import { getNearestDeparture, formatPrice, type Departure } from '../../lib/availability';
import CardActions from '../CardActions.astro';

interface FeaturedShip {
  ship: Ship;
  departure: Departure;
}

const allShips = await getShips();
const withDepartures = await Promise.all(
  allShips.map(async (ship) => ({ ship, departure: await getNearestDeparture(ship) }))
);

const bookable = withDepartures.filter((x): x is FeaturedShip => Boolean(x.departure));

// Ships marked `featured` in Sanity win; if none are marked yet, fall back
// to the soonest departures so the section is never empty.
const curatedSlugs = new Set(await getFeaturedShipSlugs());
const curated = bookable.filter((x) => curatedSlugs.has(x.ship.slug));

const featured: FeaturedShip[] = (curated.length > 0 ? curated : bookable)
  .sort((a, b) => a.departure.start.localeCompare(b.departure.start))
  .slice(0, 8);
---

<section class="featured">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Small-ship cruises</p>
        <h2>Departing soon, bookable now</h2>
      </div>
      <a class="see-all" href="/cruises/">
        All cruises
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>

  <div class="coverflow-wrap" data-coverflow>
    <ul class="coverflow-track">
      {
        featured.map(({ ship, departure }, i) => (
          <li class="cf-card" data-cf-card={i}>
            <a href={`/cruises/${ship.slug}/`} draggable="false">
              <img src={ship.heroImage} alt={`${ship.name} in the Galápagos`} loading="lazy" draggable="false" />
              <div class="cf-overlay" aria-hidden="true" />
              <h3 class="cf-title">{ship.name}</h3>
              <span class="cf-price">
                From {formatPrice(departure.price)}
              </span>
            </a>
            <CardActions
              type="cruise"
              slug={ship.slug}
              name={ship.name}
              href={`/cruises/${ship.slug}/`}
              thumbnail={ship.heroImage}
              departureStart={departure.start}
              departureEnd={departure.end}
            />
          </li>
        ))
      }
    </ul>

    <div class="coverflow-edge coverflow-edge-left" aria-hidden="true" />
    <div class="coverflow-edge coverflow-edge-right" aria-hidden="true" />

    <button type="button" class="cf-arrow cf-arrow-prev" data-cf-prev aria-label="Previous cruise">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <button type="button" class="cf-arrow cf-arrow-next" data-cf-next aria-label="Next cruise">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-coverflow]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.coverflow-track')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cf-card]'));
    if (!cards.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let isDown = false;
    let dragged = false;
    let startX = 0;
    let startScroll = 0;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    let resumeTimer: ReturnType<typeof setTimeout> | null = null;

    function cardStep() {
      return cards[0]?.getBoundingClientRect().width ?? 300;
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function startAutoplay() {
      if (prefersReducedMotion) return;
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        if (atEnd) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: cardStep(), behavior: 'smooth' });
        }
      }, 3500);
    }

    function pauseThenResume() {
      stopAutoplay();
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(startAutoplay, 3500);
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDown) return;
      const delta = startX - e.clientX;
      if (Math.abs(delta) > 6) dragged = true;
      track.scrollLeft = startScroll + delta;
    }

    function endDrag() {
      if (!isDown) return;
      isDown = false;
      track.classList.remove('is-dragging');
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', endDrag);
      window.removeEventListener('pointercancel', endDrag);
      pauseThenResume();
    }

    track.addEventListener('pointerdown', (e) => {
      // Let the favorite/cart buttons handle their own clicks untouched.
      // (Deliberately no setPointerCapture here — capturing the pointer
      // retargets the resulting click to the track, which is what was
      // eating clicks on the fav/cart buttons.)
      if ((e.target as HTMLElement).closest('[data-card-actions]')) return;
      isDown = true;
      dragged = false;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.classList.add('is-dragging');
      stopAutoplay();
      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', endDrag, { once: true });
      window.addEventListener('pointercancel', endDrag, { once: true });
    });

    // A drag that moved the track shouldn't also follow the card's link.
    track.addEventListener(
      'click',
      (e) => {
        if (dragged) {
          e.preventDefault();
          e.stopPropagation();
          dragged = false;
        }
      },
      true
    );

    root.querySelector('[data-cf-prev]')?.addEventListener('click', () => {
      track.scrollBy({ left: -cardStep(), behavior: 'smooth' });
      pauseThenResume();
    });

    root.querySelector('[data-cf-next]')?.addEventListener('click', () => {
      track.scrollBy({ left: cardStep(), behavior: 'smooth' });
      pauseThenResume();
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', () => {
      if (!isDown) startAutoplay();
    });

    startAutoplay();
  });
</script>

<style>
  .featured {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .section-head .eyebrow {
    color: var(--brand-deep);
    margin-bottom: 0.5rem;
  }

  .section-head h2 {
    font-size: var(--text-2xl);
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-deep);
    white-space: nowrap;
    padding-block: 0.4rem;
  }

  .see-all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .coverflow-wrap {
    position: relative;
  }

  .coverflow-track {
    display: flex;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    cursor: grab;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .coverflow-track::-webkit-scrollbar {
    display: none;
  }

  .coverflow-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .cf-card {
    position: relative;
    flex: 0 0 auto;
    height: clamp(320px, 46vw, 520px);
    aspect-ratio: 0.58;
    scroll-snap-align: start;
  }

  .cf-card a {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }

  .cf-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
  }

  .cf-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 15, 30, 0.55) 0%,
      rgba(10, 15, 30, 0) 32%,
      rgba(10, 15, 30, 0) 66%,
      rgba(10, 15, 30, 0.4) 100%
    );
  }

  .cf-title {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 1.1rem 5rem 1.1rem 1rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.25;
    color: var(--white);
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cf-price {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    background: rgba(16, 25, 46, 0.72);
    color: var(--white);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.45rem 0.8rem;
    border-radius: 6px;
  }

  .coverflow-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    pointer-events: none;
    z-index: 2;
  }

  .coverflow-edge-left {
    left: 0;
    background: linear-gradient(90deg, rgba(16, 25, 46, 0.16), transparent);
  }

  .coverflow-edge-right {
    right: 0;
    background: linear-gradient(270deg, rgba(16, 25, 46, 0.16), transparent);
  }

  .cf-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--white);
    opacity: 0.55;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
    transition: opacity 0.2s ease;
    z-index: 3;
    cursor: pointer;
  }

  .cf-arrow:hover,
  .cf-arrow:focus-visible {
    opacity: 1;
  }

  .cf-arrow-prev {
    left: 0.6rem;
  }

  .cf-arrow-next {
    right: 0.6rem;
  }

  @media (max-width: 640px) {
    .cf-card {
      height: clamp(260px, 70vw, 380px);
    }
  }
</style>
