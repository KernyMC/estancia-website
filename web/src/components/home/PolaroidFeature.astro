---
interface PolaroidImage {
  src: string;
  alt: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  ctaLabel?: string;
  ctaHref?: string;
  imageA: PolaroidImage;
  imageB: PolaroidImage;
  imageC?: PolaroidImage;
  reverse?: boolean;
}

const { eyebrow, title, body, ctaLabel, ctaHref, imageA, imageB, imageC, reverse = false } = Astro.props;
---

<section class="polaroid-feature" class:list={{ reverse }}>
  <div class="container polaroid-grid">
    <div class="polaroid-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <p class="polaroid-body">{body}</p>
      {
        ctaLabel && ctaHref && (
          <a class="btn btn-primary" href={ctaHref}>
            {ctaLabel}
          </a>
        )
      }
    </div>

    <div class="polaroid-images">
      <div class="polaroid-stack" class:list={{ 'has-third': !!imageC }}>
        <figure class="polaroid polaroid-a">
          <img src={imageA.src} alt={imageA.alt} loading="lazy" />
        </figure>
        <figure class="polaroid polaroid-b">
          <img src={imageB.src} alt={imageB.alt} loading="lazy" />
        </figure>
        {
          imageC && (
            <figure class="polaroid polaroid-c">
              <img src={imageC.src} alt={imageC.alt} loading="lazy" />
            </figure>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Bring the hovered/tapped polaroid in front of the others so it can be
  // seen in full — :hover alone handles mouse, but touch has no hover, so a
  // tap toggles the same "in front" state via click (fires on tap too).
  document.querySelectorAll<HTMLElement>('.polaroid-stack').forEach((stack) => {
    const polaroids = stack.querySelectorAll<HTMLElement>('.polaroid');
    polaroids.forEach((polaroid) => {
      polaroid.addEventListener('click', () => {
        polaroids.forEach((other) => other.classList.remove('is-front'));
        polaroid.classList.add('is-front');
      });
    });
  });
</script>

<style>
  .polaroid-feature {
    padding-block: clamp(3rem, 10vw, 96px);
    overflow: hidden;
  }

  .polaroid-grid {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .polaroid-text {
    flex: 1 1 45%;
    order: 1;
  }

  /* .eyebrow (global.css) has no color, h2 (global.css) has no size — every
     section on this site redeclares both locally (same pattern as the
     Puerto Ayora block right above this one in StaysAndReviews.astro). */
  .polaroid-text .eyebrow {
    color: var(--brand-deep);
    margin-bottom: 0.5rem;
  }

  .polaroid-text h2 {
    font-size: var(--text-2xl);
  }

  .polaroid-body {
    margin-top: 1rem;
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: 46ch;
  }

  .polaroid-text .btn {
    margin-top: 1.75rem;
  }

  .polaroid-images {
    flex: 1 1 55%;
    order: 2;
    display: flex;
    justify-content: center;
  }

  .polaroid-feature.reverse .polaroid-text {
    order: 2;
  }

  .polaroid-feature.reverse .polaroid-images {
    order: 1;
  }

  /* Landscape photos (2000x1333) — the stack width drives everything below via %. */
  .polaroid-stack {
    position: relative;
    width: min(460px, 100%);
    aspect-ratio: 10 / 9;
  }

  /* A third photo needs more headroom so polaroid-c can sit above the
     other two without clipping the stack. */
  .polaroid-stack.has-third {
    width: min(500px, 100%);
    aspect-ratio: 1 / 1;
  }

  .polaroid {
    position: absolute;
    margin: 0;
    background: var(--white);
    padding: 12px 12px 44px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
    transition: none;
    cursor: pointer;
  }

  /* Whichever photo is hovered (mouse) or tapped (touch, via the click
     listener above) jumps above its neighbors so it's fully visible instead
     of partly covered by the one stacked on top of it. */
  .polaroid:hover,
  .polaroid.is-front {
    z-index: 10;
  }

  .polaroid img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .polaroid-a {
    width: 64%;
    top: 0;
    right: 0;
    rotate: -7deg;
    z-index: 1;
  }

  .polaroid-b {
    width: 72%;
    bottom: 0;
    left: 0;
    rotate: 5deg;
    z-index: 2;
  }

  .has-third .polaroid-a {
    width: 52%;
    top: 0;
    right: 4%;
  }

  .has-third .polaroid-b {
    width: 58%;
    bottom: 6%;
    left: 0;
  }

  .polaroid-c {
    width: 46%;
    top: 38%;
    left: 30%;
    rotate: -3deg;
    z-index: 3;
  }

  .polaroid-c:hover {
    rotate: 1deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .polaroid {
      transition: rotate 300ms ease-out, translate 300ms ease-out, box-shadow 300ms ease-out;
    }

    .polaroid:hover {
      translate: 0 -6px;
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2);
    }

    .polaroid-a:hover {
      rotate: -1deg;
    }

    .polaroid-b:hover {
      rotate: 1deg;
    }
  }

  @media (max-width: 1024px) {
    .polaroid-a {
      rotate: -3.5deg;
      right: 8%;
    }

    .polaroid-b {
      rotate: 2.5deg;
      left: 8%;
    }

    .has-third .polaroid-a {
      right: 4%;
    }

    .has-third .polaroid-b {
      left: 0;
    }
  }

  @media (max-width: 640px) {
    .polaroid-grid {
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
    }

    .polaroid-text,
    .polaroid-images {
      order: initial;
      flex-basis: auto;
    }

    .polaroid-feature.reverse .polaroid-text,
    .polaroid-feature.reverse .polaroid-images {
      order: initial;
    }

    .polaroid-stack {
      width: 100%;
      aspect-ratio: auto;
      display: flex;
      justify-content: center;
      gap: 0;
    }

    .polaroid {
      position: static;
      width: 46%;
      padding: 8px 8px 28px;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
    }

    .polaroid-a {
      rotate: -3deg;
      margin-right: -6%;
      z-index: 1;
    }

    .polaroid-b {
      rotate: 3deg;
      margin-left: -6%;
      z-index: 2;
    }

    /* The desktop .has-third rule (higher specificity: two classes) still
       forces aspect-ratio:1/1 + a 500px width cap here otherwise — that
       squared the stack to ~full-viewport-width tall on mobile, and with
       flex's default align-items:stretch every polaroid stretched to fill
       it, leaving the huge blank strip below each photo (found 2026-08-30).
       Reset both, and lay out 2 photos per row wrapping to a 3rd row below
       instead of cramming 3 across. */
    .polaroid-stack.has-third {
      width: 100%;
      aspect-ratio: auto;
      flex-wrap: wrap;
      row-gap: 1.25rem;
    }

    .has-third .polaroid-a,
    .has-third .polaroid-b,
    .has-third .polaroid-c {
      width: 46%;
    }

    .polaroid-c {
      rotate: -2deg;
      z-index: 1;
    }
  }
</style>
