---
import { getTours, type Tour } from '../../lib/content';
import { formatPrice } from '../../lib/availability';
import { requiresDate, todayIso, tourFromPrice } from '../../lib/seasonal-pricing';

const today = todayIso();
const dayTours: Tour[] = (await getTours('day-tours')).filter((t) => tourFromPrice(t, today));
const initialIndex = Math.floor(dayTours.length / 2);
---

<section class="tours-band">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Island adventures</p>
      <h2>Day tours, ready to book today</h2>
      <a class="see-all" href="/tours/day-tours/">
        All day tours
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>

  <div class="tour-coverflow-outer" data-tour-coverflow>
    <div class="tour-coverflow-wrap">
      <ul class="tour-coverflow">
        {
          [0, 1, 2].map((set) =>
            dayTours.map((tour, i) => (
              <li class:list={{ featured: set === 1 && i === initialIndex }} data-tc-set={set}>
                <a class="tour-card" href={`/tours/${tour.slug}/`} draggable="false">
                  <img src={tour.thumbnail} alt={tour.name} loading="lazy" draggable="false" />
                  <div class="tour-overlay" aria-hidden="true" />
                  {tour.category && <span class="tour-chip">{tour.category.name}</span>}
                  <div class="tour-body">
                    <h3>{tour.name}</h3>
                    <p class="tour-price">
                      {requiresDate(tour, today) && <span class="price-pp">from</span>}
                      <span class="price-value">{formatPrice(tourFromPrice(tour, today)!)}</span>
                      <span class="price-pp">/ person</span>
                    </p>
                    <span class="btn btn-primary tour-cta">View Trip</span>
                  </div>
                </a>
              </li>
            ))
          )
        }
      </ul>
    </div>

    <button type="button" class="tc-arrow tc-arrow-prev" data-tc-prev aria-label="Previous tour">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <button type="button" class="tc-arrow tc-arrow-next" data-tc-next aria-label="Next tour">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>
</section>

<script>
  // 3 identical sets of cards are rendered ([data-tc-set] 0/1/2) so the
  // carousel can loop forever: once scroll drifts into the outer sets, the
  // scroll position is silently snapped back into the middle set (same
  // content either way, so the reset is invisible to the user).
  document.querySelectorAll<HTMLElement>('[data-tour-coverflow]').forEach((root) => {
    const wrap = root.querySelector<HTMLElement>('.tour-coverflow-wrap')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.tour-coverflow > li'));
    if (!wrap || cards.length === 0) return;

    // Measured from the DOM (offset between the same card in two adjacent
    // sets) instead of scrollWidth/3 — the track has one big padding-inline
    // only at its outer edges, so scrollWidth/3 doesn't equal a real set's
    // width and made the loop reset land in the wrong place.
    const set1Start = cards.find((c) => c.dataset.tcSet === '1')!.offsetLeft;
    const setSpan = cards.find((c) => c.dataset.tcSet === '2')!.offsetLeft - set1Start;

    let ticking = false;
    // Correcting scrollLeft mid-gesture fights the browser's own touch
    // scroll/momentum — on phones this is what made the swipe feel broken
    // (the track would yank back while a finger was still dragging it).
    // 'scrollend' fires only once the gesture (and any momentum) is fully
    // done, so the loop-reset never interrupts an in-progress swipe. Older
    // browsers without 'scrollend' fall back to a debounced correction that
    // waits for scrolling to pause instead of running on every frame.
    const supportsScrollEnd = 'onscrollend' in window;
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    function normalizeScroll() {
      // wrap has `scroll-behavior: smooth` in CSS, which also applies to
      // plain `scrollLeft` assignment — without behavior: 'instant' here,
      // this correction animates and reads as "jumping back to the start".
      //
      // Thresholds are relative to set1Start, not 0 — the track's leading
      // padding-inline puts set1's cards well past scrollLeft 0, so anchoring
      // at 0 (found 2026-08-02) left almost no headroom before the "past
      // set1" threshold on one side, making that direction's arrow appear to
      // do nothing (it scrolled, then the correction yanked it straight back).
      const relative = wrap.scrollLeft - set1Start;
      if (relative < -setSpan * 0.5) {
        wrap.scrollTo({ left: wrap.scrollLeft + setSpan, behavior: 'instant' });
      } else if (relative > setSpan * 1.5) {
        wrap.scrollTo({ left: wrap.scrollLeft - setSpan, behavior: 'instant' });
      }
    }

    function updateActive() {
      ticking = false;
      const wrapRect = wrap.getBoundingClientRect();
      const center = wrapRect.left + wrapRect.width / 2;

      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        card.classList.toggle('featured', Math.abs(cardCenter - center) < rect.width / 2);
      });
    }

    wrap.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
      if (!supportsScrollEnd) {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          normalizeScroll();
          updateActive();
        }, 150);
      }
    });

    if (supportsScrollEnd) {
      wrap.addEventListener('scrollend', () => {
        normalizeScroll();
        updateActive();
      });
    }

    function scrollByCard(dir: 1 | -1) {
      const card = cards[0];
      const gap = parseFloat(getComputedStyle(card.parentElement!).gap || '0');
      wrap.scrollBy({ left: dir * (card.getBoundingClientRect().width + gap), behavior: 'smooth' });
    }

    root.querySelector('[data-tc-prev]')?.addEventListener('click', () => scrollByCard(-1));
    root.querySelector('[data-tc-next]')?.addEventListener('click', () => scrollByCard(1));

    const initial =
      cards.find((c) => c.dataset.tcSet === '1' && c.classList.contains('featured')) ??
      cards[Math.floor(cards.length / 2)];
    // Not scrollIntoView({block: 'nearest'}) — on first paint this section
    // sits below the fold, so "nearest" still counts as "not visible" and
    // the browser scrolls the whole page down to it (found 2026-08-26: this
    // made every home load, and every click on the header logo, land on
    // this section instead of the hero). Scrolling wrap.scrollLeft directly
    // touches only the carousel, never the page.
    if (initial) {
      const wrapRect = wrap.getBoundingClientRect();
      const cardRect = initial.getBoundingClientRect();
      wrap.scrollLeft += cardRect.left + cardRect.width / 2 - (wrapRect.left + wrapRect.width / 2);
    }
    updateActive();
    window.addEventListener('resize', updateActive);
  });
</script>

<style>
  .tours-band {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    background: var(--white);
    overflow: hidden;
  }

  .section-head {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .section-head .eyebrow {
    color: var(--brand-deep);
    margin-bottom: 0.5rem;
  }

  .section-head h2 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.01em;
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-deep);
    white-space: nowrap;
  }

  .see-all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .tour-coverflow-outer {
    position: relative;
  }

  .tour-coverflow-wrap {
    max-width: var(--container);
    margin-inline: auto;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* `mandatory` (tried previously) forces the browser to force-snap after
       every swipe, including right after our own instant scrollLeft
       correction below (the "3 sets" infinite-loop trick) — if that jump
       isn't pixel-perfectly aligned to a snap point (clamp()-based
       responsive widths are fractional), mandatory fights the correction
       and can cascade the position toward 0, reading as "swipe teleports to
       the first card". `proximity` only snaps near an existing snap point,
       so it never fights the loop correction. */
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    padding-block: 1rem;
    -ms-overflow-style: none;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .tour-coverflow-wrap::-webkit-scrollbar {
    display: none;
  }

  .tour-coverflow {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    list-style: none;
    margin: 0;
    padding-inline: clamp(1rem, 22vw, 32%);
  }

  .tour-coverflow > li {
    scroll-snap-align: center;
  }

  .tc-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-soft);
    z-index: 5;
  }

  .tc-arrow:hover {
    border-color: var(--brand);
    color: var(--brand-deep);
  }

  .tc-arrow-prev {
    left: clamp(0.25rem, 2vw, 1.5rem);
  }

  .tc-arrow-next {
    right: clamp(0.25rem, 2vw, 1.5rem);
  }

  .tour-coverflow > li {
    flex: 0 0 auto;
    width: clamp(220px, 24vw, 300px);
    height: clamp(360px, 42vw, 440px);
    scale: 0.8;
    opacity: 0.7;
    transition: scale 0.35s ease, opacity 0.35s ease;
  }

  .tour-coverflow > li.featured {
    scale: 1;
    opacity: 1;
    z-index: 2;
  }

  .tour-card {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition: translate 0.25s ease;
  }

  .tour-card:hover {
    translate: 0 -4px;
  }

  .tour-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 25, 46, 0) 45%, rgba(16, 25, 46, 0.85) 100%);
  }

  .tour-chip {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(252, 251, 248, 0.92);
    color: var(--ink);
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }

  .tour-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.1rem;
    color: var(--white);
  }

  .featured .tour-body {
    text-align: center;
  }

  .tour-body h3 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 650;
    line-height: 1.35;
  }

  .tour-price {
    display: none;
    align-items: baseline;
    justify-content: center;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }

  .featured .tour-price {
    display: flex;
  }

  .price-value {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 620;
  }

  .price-pp {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .tour-cta {
    display: none;
    margin-top: 0.9rem;
  }

  .featured .tour-cta {
    display: inline-block;
  }

  @media (max-width: 720px) {
    .tour-coverflow > li {
      width: 200px;
      height: 320px;
    }

    .tc-arrow {
      width: 36px;
      height: 36px;
    }
  }
</style>
