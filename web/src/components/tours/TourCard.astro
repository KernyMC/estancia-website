---
/**
 * Shared tour card — full-bleed photo with a bottom gradient scrim, used by
 * both the generic grid (ToursGrid.astro) and the "More tours" section on
 * tours/[slug].astro, so the two can never visually drift apart again.
 * Renders only the <a> card — CardActions.astro is a sibling rendered by
 * the caller (see CardActions.astro's own doc for why).
 */
import { formatPrice } from '../../lib/availability';
import type { Tour } from '../../lib/content';
import { requiresDate, todayIso, tourFromPrice } from '../../lib/seasonal-pricing';

interface Props {
  tour: Pick<Tour, 'slug' | 'name' | 'thumbnail' | 'durationDays' | 'price' | 'childPrice' | 'seasonalPrices'>;
  /** Heading level for the card title — h2 in a flat grid, h3 under a section that already has its own h2. */
  headingLevel?: 'h2' | 'h3';
}

const { tour, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const today = todayIso();
const fromPrice = tourFromPrice(tour, today);
// "from" only when the price really varies by date — plain tours look exactly as before.
const isSeasonal = requiresDate(tour, today);
---

<a class="tour-card" href={`/tours/${tour.slug}/`}>
  <img src={tour.thumbnail} alt={tour.name} loading="lazy" />
  <div class="card-overlay" aria-hidden="true" />
  <span class="card-chip">{tour.durationDays} day{tour.durationDays > 1 ? 's' : ''}</span>
  <div class="card-body">
    <Heading>{tour.name}</Heading>
    {fromPrice && (
      <p class="card-price">
        {isSeasonal && <span class="price-pp">from</span>}
        <span class="price-value">{formatPrice(fromPrice)}</span>
        <span class="price-pp">/ person</span>
      </p>
    )}
  </div>
</a>

<style>
  /* Full-bleed photo card — the image fills the whole card, a bottom
     gradient scrim keeps the title/price legible without covering the
     photo with an opaque block. */
  .tour-card {
    position: relative;
    display: block;
    height: clamp(300px, 30vw, 380px);
    background: var(--sand);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition: box-shadow 0.25s ease, translate 0.25s ease;
  }

  .tour-card:hover {
    translate: 0 -3px;
  }

  .tour-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 25, 46, 0) 40%, rgba(16, 25, 46, 0.85) 100%);
  }

  .card-chip {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(252, 251, 248, 0.92);
    color: var(--ink);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }

  .card-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.1rem 1.2rem 1.3rem;
    color: var(--white);
  }

  .card-body :global(h2),
  .card-body :global(h3) {
    font-size: var(--text-base);
    font-family: var(--font-body);
    font-weight: 650;
    line-height: 1.35;
  }

  .card-price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .price-value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 620;
  }

  .price-pp {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.75);
  }
</style>
