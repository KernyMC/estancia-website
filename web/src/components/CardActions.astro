---
/**
 * Favorite + add-to-cart buttons for a trip card. Renders as a SIBLING of
 * the card's <a> — every card markup in this repo is a full-bleed <a>
 * wrapping the whole card, and a <button> cannot nest inside an <a> (invalid
 * HTML, and it would eat the card's click). The wrapper li/container this
 * gets placed in must be `position: relative` for the absolute overlay to
 * anchor correctly — see the CSS note at each call site.
 */
export interface CardActionItem {
  type: 'tour' | 'cruise';
  slug: string;
  name: string;
  href: string;
  thumbnail?: string;
  /** Cruises only. */
  departureStart?: string;
  departureEnd?: string;
}

interface Props extends CardActionItem {
  /** Tours without a bookable price, or cruises with no open departure, get favorite-only. */
  canAddToCart?: boolean;
}

const { canAddToCart = true, ...item } = Astro.props;

// Tours pay directly again (same BookingForm as cruises) — no more blanket
// exclusion here. Whether a given tour/cruise can add to cart is entirely
// up to the `canAddToCart` prop the call site passes (e.g. no price yet).
const showCart = canAddToCart;
---

<div class="card-actions" data-card-actions data-item={JSON.stringify(item)}>
  <button type="button" class="icon-btn fav-btn" data-fav aria-pressed="false">
    <span class="visually-hidden">Save {item.name}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" />
    </svg>
  </button>
  {
    showCart && (
      <button type="button" class="icon-btn cart-btn" data-add-cart aria-pressed="false">
        <span class="visually-hidden">Add {item.name} to cart</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        <span class="glare" aria-hidden="true" />
      </button>
    )
  }
</div>

<script>
  import { addToCart, toggleFavorite, isInCart, isFavorite, itemKey, STORE_EVENT } from '../scripts/cart-store';
  import type { CardActionItem } from './CardActions.astro';

  function paint(root: HTMLElement, item: CardActionItem) {
    const key = itemKey(item);
    const favBtn = root.querySelector<HTMLButtonElement>('[data-fav]');
    const cartBtn = root.querySelector<HTMLButtonElement>('[data-add-cart]');
    if (favBtn) {
      const active = isFavorite(key);
      favBtn.classList.toggle('is-active', active);
      favBtn.setAttribute('aria-pressed', String(active));
    }
    if (cartBtn) {
      const active = isInCart(key);
      cartBtn.classList.toggle('is-active', active);
      cartBtn.setAttribute('aria-pressed', String(active));
    }
  }

  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-card-actions]'));
  const items = roots.map((root) => JSON.parse(root.dataset.item ?? '{}') as CardActionItem);

  roots.forEach((root, i) => {
    const item = items[i]!;
    paint(root, item);

    root.querySelector('[data-fav]')?.addEventListener('click', () => {
      const favBtn = root.querySelector<HTMLButtonElement>('[data-fav]')!;
      toggleFavorite(item);
      favBtn.classList.add('is-popping');
      favBtn.addEventListener('animationend', () => favBtn.classList.remove('is-popping'), { once: true });
    });

    root.querySelector('[data-add-cart]')?.addEventListener('click', () => {
      const key = itemKey(item);
      if (isInCart(key)) return; // already added — the drawer is where quantity/removal happens
      addToCart({ ...item, adults: 1, children: 0 });
    });
  });

  window.addEventListener(STORE_EVENT, () => {
    roots.forEach((root, i) => paint(root, items[i]!));
  });
</script>

<style>
  .card-actions {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }

  .fav-btn svg,
  .cart-btn svg {
    fill: none;
    transition: color 0.25s ease, fill 0.25s ease;
  }

  .fav-btn.is-active {
    color: #e2445c;
  }

  .fav-btn.is-active svg {
    fill: currentColor;
  }

  .fav-btn:hover:not(.is-active),
  .fav-btn:focus-visible:not(.is-active) {
    color: var(--brand);
  }

  .fav-btn:hover:not(.is-active) svg,
  .fav-btn:focus-visible:not(.is-active) svg {
    fill: currentColor;
  }

  .fav-btn:hover svg,
  .fav-btn:focus-visible svg,
  .fav-btn.is-popping svg {
    animation: heart-pulse 0.4s ease;
  }

  @keyframes heart-pulse {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.18;
    }
  }

  .cart-btn:hover,
  .cart-btn.is-active {
    color: var(--brand);
  }

  .cart-btn.is-active svg {
    fill: currentColor;
  }

  .cart-btn {
    position: relative;
    overflow: hidden;
  }

  .glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.85) 50%, transparent 60%);
    translate: -120% 0;
    pointer-events: none;
  }

  .cart-btn:hover .glare,
  .cart-btn:focus-visible .glare {
    animation: glare-sweep 1.6s linear infinite;
  }

  @keyframes glare-sweep {
    to {
      translate: 120% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fav-btn:hover svg,
    .fav-btn:focus-visible svg,
    .fav-btn.is-popping svg {
      animation: none;
    }
    .cart-btn:hover .glare,
    .cart-btn:focus-visible .glare {
      animation: none;
    }
  }
</style>
