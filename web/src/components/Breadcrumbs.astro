---
import { breadcrumbLd, jsonLdScript, type Crumb } from '../lib/seo';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const ld = breadcrumbLd(items);
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      {
        items.map((c, i) => (
          <li>
            {c.href && i < items.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<script type="application/ld+json" set:html={jsonLdScript(ld)} />

<style>
  .breadcrumbs {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  li:not(:first-child)::before {
    content: '/';
    color: var(--line);
  }

  a {
    color: var(--ink-soft);
    font-weight: 550;
  }

  a:hover {
    color: var(--brand-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  [aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
</style>
