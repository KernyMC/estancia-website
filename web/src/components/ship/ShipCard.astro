---
/**
 * Shared cruise card, used by both the generic grid (cruises/index.astro)
 * and "Other cruises to consider" (RelatedCruises.astro), so the two can
 * never visually drift apart again. Renders only the <a> card —
 * CardActions.astro is a sibling rendered by the caller (see
 * CardActions.astro's own doc for why).
 */
import { formatDateRange, formatPrice, type Departure } from '../../lib/availability';
import type { Ship } from '../../lib/content';

interface Props {
  ship: Pick<Ship, 'slug' | 'name' | 'heroImage' | 'boatType' | 'category' | 'hasLiveAvailability' | 'indicativePrice'>;
  departure: Departure | undefined;
}

const { ship, departure } = Astro.props;
---

<a class="ship-card" href={`/cruises/${ship.slug}/`}>
  <div class="card-media">
    <img src={ship.heroImage} alt={`${ship.name} in the Galápagos`} loading="lazy" />
    {ship.category && <span class="card-chip">{ship.category.name}</span>}
  </div>
  <div class="card-body">
    <h2>{ship.name}</h2>
    <p class="card-meta">
      {ship.boatType}
      {departure && ` · ${departure.capacity} guests`}
    </p>
    {departure ? (
      <>
        <p class="card-dates">{formatDateRange(departure.start, departure.end)}</p>
        <p class="card-price">
          <span class="price-from">from</span>
          <span class="price-value">{formatPrice(departure.price)}</span>
          <span class="price-pp">/ person</span>
          {departure.promo && <span class="price-promo">Promo</span>}
        </p>
      </>
    ) : !ship.hasLiveAvailability ? (
      ship.indicativePrice ? (
        <p class="card-price">
          <span class="price-from">from</span>
          <span class="price-value">{formatPrice(ship.indicativePrice)}</span>
          <span class="price-pp">/ person</span>
        </p>
      ) : (
        <p class="card-unavailable">Contact for pricing</p>
      )
    ) : (
      <p class="card-unavailable">Check availability</p>
    )}
  </div>
</a>

<style>
  .ship-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.25s ease, translate 0.25s ease;
  }

  .ship-card:hover {
    box-shadow: var(--shadow-soft);
    translate: 0 -3px;
  }

  /* Fixed height (not aspect-ratio) on purpose: a square-ish source photo
     combined with aspect-ratio on a flex-column item made that one card's
     media taller than its siblings even though all cards share the same
     width, breaking row symmetry. */
  .card-media {
    position: relative;
    height: clamp(200px, 24vw, 260px);
    background: var(--sand);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-chip {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(252, 251, 248, 0.92);
    color: var(--ink);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem 1.3rem;
    flex: 1;
  }

  .card-body h2 {
    font-size: var(--text-xl);
  }

  .card-meta {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .card-dates {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-deep);
    margin-top: 0.35rem;
  }

  .card-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .price-from,
  .price-pp {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .price-value {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .price-promo {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--white);
    background: var(--error);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-left: 0.25rem;
  }

  .card-unavailable {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
