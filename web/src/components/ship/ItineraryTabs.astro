---
import type { ItineraryRoute } from '../../lib/content';

interface Props {
  routes: ItineraryRoute[];
}

const { routes } = Astro.props;
---

<div class="itinerary-tabs" data-itinerary-tabs>
  {
    routes.length > 1 && (
      <div class="tab-buttons" role="tablist" aria-label="Itinerary route">
        {routes.map((route, i) => (
          <button
            type="button"
            class="tab-btn"
            class:list={{ active: i === 0 }}
            role="tab"
            aria-selected={i === 0}
            data-tab-index={i}
          >
            {route.route_name}
          </button>
        ))}
      </div>
    )
  }

  {
    routes.map((route, i) => (
      <div class="tab-panel" class:list={{ active: i === 0 }} role="tabpanel" data-tab-panel={i}>
        <p class="route-duration">{route.duration}</p>
        <ol class="day-list">
          {route.days.map((day) => (
            <li class="day-row">
              <span class="day-label">{day.day_label}</span>
              <div class="day-activities">
                {day.am && <p><strong>AM</strong> {day.am}</p>}
                {day.pm && <p><strong>PM</strong> {day.pm}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-itinerary-tabs]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const panels = root.querySelectorAll<HTMLElement>('.tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = btn.dataset.tabIndex;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => p.classList.toggle('active', p.dataset.tabPanel === idx));
      });
    });
  });
</script>

<style>
  .tab-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tab-btn {
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
  }

  .tab-btn:hover {
    border-color: var(--brand);
    color: var(--brand-deep);
  }

  .tab-btn.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  .route-duration {
    font-weight: 650;
    color: var(--brand-deep);
    margin-bottom: 1.25rem;
  }

  .day-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .day-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1.25rem;
    padding: 1rem 1.2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .day-label {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .day-activities p {
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .day-activities p + p {
    margin-top: 0.35rem;
  }

  .day-activities strong {
    color: var(--brand-deep);
    font-weight: 700;
    margin-right: 0.3rem;
  }

  @media (max-width: 620px) {
    .day-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
