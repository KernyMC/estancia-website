---
import type { GalleryTab } from '../../lib/content';
import Lightbox from '../Lightbox.astro';

interface Props {
  tabs: GalleryTab[];
  shipName: string;
}

const { tabs, shipName } = Astro.props;
---

<div class="gallery-tabs" data-gallery-tabs data-lightbox-root>
  {
    tabs.length > 1 && (
      <div class="tab-buttons" role="tablist" aria-label="Ship gallery">
        {tabs.map((tab, i) => (
          <button
            type="button"
            class="tab-btn"
            class:list={{ active: i === 0 }}
            role="tab"
            aria-selected={i === 0}
            data-tab-index={i}
          >
            {tab.label}
          </button>
        ))}
      </div>
    )
  }

  {
    tabs.map((tab, i) => (
      <div class="tab-panel" class:list={{ active: i === 0 }} role="tabpanel" data-tab-panel={i} data-lightbox-group>
        <div class="image-strip">
          {tab.images.map((src, idx) => (
            <div class="image-cell" class:list={{ 'is-hidden': idx > 5 }}>
              <img src={src} alt={`${shipName}, ${tab.label}`} loading="lazy" class="lightbox-trigger" tabindex="0" role="button" />
              {idx === 5 && tab.images.length > 6 && (
                <span class="image-more-overlay" aria-hidden="true">+{tab.images.length - 6}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    ))
  }

  <Lightbox />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery-tabs]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const panels = root.querySelectorAll<HTMLElement>('.tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = btn.dataset.tabIndex;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => p.classList.toggle('active', p.dataset.tabPanel === idx));
      });
    });
  });
</script>

<style>
  .tab-buttons {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .tab-btn {
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
  }

  .tab-btn:hover {
    border-color: var(--brand);
    color: var(--brand-deep);
  }

  .tab-btn.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  .image-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .image-cell {
    position: relative;
  }

  .image-cell.is-hidden {
    display: none;
  }

  .image-cell img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
  }

  .image-more-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--white);
    background: rgba(16, 25, 46, 0.55);
    border-radius: var(--radius);
    pointer-events: none;
  }

  .lightbox-trigger {
    cursor: pointer;
  }

  @media (max-width: 700px) {
    .image-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
