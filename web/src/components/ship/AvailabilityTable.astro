---
import { formatDateRange, formatPrice, type Departure } from '../../lib/availability';
import BookingForm from '../BookingForm.astro';

interface Props {
  departures: Departure[];
  shipSlug: string;
  shipName: string;
  thumbnail?: string;
  /** True when the vendor availability API can't currently be reached (not just sold out). */
  apiDown?: boolean;
}

const { departures, shipSlug, shipName, thumbnail, apiDown } = Astro.props;
const shipHref = `/cruises/${shipSlug}/`;

const PAGE_SIZE = 7;
const pageCount = Math.ceil(departures.length / PAGE_SIZE);

// From/To filter bounds — the actual span of departures we have, never an
// invented wider range (there's nothing to show outside it anyway).
const departureDates = departures.map((d) => d.start).sort();
const minDate = departureDates[0];
const maxDate = departureDates[departureDates.length - 1];
---

{
  apiDown ? (
    <p class="no-departures availability-down">
      Availability is currently not available. We're having trouble reaching the booking system. Please check back shortly or <a href="/contact/">contact us</a> directly.
    </p>
  ) : departures.length === 0 ? (
    <p class="no-departures">
      No open departures in the next 6 months. <a href="/contact/">Ask us about future dates</a>.
    </p>
  ) : (
    <div
      class="avail-table-wrap"
      data-avail-pager
      data-page-size={PAGE_SIZE}
      data-ship-slug={shipSlug}
      data-ship-name={shipName}
      data-ship-href={shipHref}
      data-ship-thumbnail={thumbnail}
    >
      <div class="avail-toolbar">
        <div class="avail-filters">
          <label class="date-field">
            <span class="date-field-label">From</span>
            <span class="date-input-wrap">
              <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M3 10h18M8 2v4M16 2v4" />
              </svg>
              <input type="date" data-filter-from min={minDate} max={maxDate} value={minDate} aria-label="From date" />
            </span>
          </label>
          <label class="date-field">
            <span class="date-field-label">To</span>
            <span class="date-input-wrap">
              <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M3 10h18M8 2v4M16 2v4" />
              </svg>
              <input type="date" data-filter-to min={minDate} max={maxDate} value={maxDate} aria-label="To date" />
            </span>
          </label>
          <div class="sort-field">
            <span class="date-field-label" id={`avail-sort-label-${shipSlug}`}>Sort by</span>
            <div class="sort-picker" data-sort-picker>
              <button
                type="button"
                class="sort-picker-btn"
                data-sort-btn
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby={`avail-sort-label-${shipSlug}`}
              >
                <span data-sort-value>Date: soonest first</span>
                <svg class="sort-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </button>
              <ul class="sort-list" data-sort-list role="listbox" hidden>
                <li role="option" aria-selected="true" data-sort-option="date-asc" tabindex="0">Date: soonest first</li>
                <li role="option" aria-selected="false" data-sort-option="date-desc" tabindex="-1">Date: latest first</li>
                <li role="option" aria-selected="false" data-sort-option="price-asc" tabindex="-1">Price: low to high</li>
                <li role="option" aria-selected="false" data-sort-option="price-desc" tabindex="-1">Price: high to low</li>
              </ul>
            </div>
          </div>
        </div>
        <button type="button" class="btn btn-primary search-btn" data-filter-apply>
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          Search Availability
        </button>
      </div>
      <table class="avail-table">
        <thead>
          <tr>
            <th scope="col">Dates</th>
            <th scope="col">Spots left</th>
            <th scope="col">Price / person</th>
            <th scope="col">
              <span class="visually-hidden">Book</span>
            </th>
            <th scope="col">
              <span class="visually-hidden">Add to cart</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {departures.map((dep, i) => (
            <tr data-avail-row data-page={Math.floor(i / PAGE_SIZE)} data-departure-start={dep.start} data-departure-price={dep.price}>
              <td>{formatDateRange(dep.start, dep.end)}</td>
              <td>{dep.free}</td>
              <td>
                {formatPrice(dep.price)}
                {dep.promo && <span class="promo-tag">Promo</span>}
              </td>
              <td>
                <button
                  type="button"
                  class="btn btn-primary btn-sm"
                  data-book-departure
                  data-start={dep.start}
                  data-dates={formatDateRange(dep.start, dep.end)}
                  data-price={formatPrice(dep.price)}
                >
                  Book now
                </button>
              </td>
              <td>
                <button
                  type="button"
                  class="icon-btn cart-row-btn"
                  data-add-departure
                  data-start={dep.start}
                  data-end={dep.end}
                  aria-pressed="false"
                  aria-label={`Add ${shipName}, ${formatDateRange(dep.start, dep.end)}, to cart`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z" />
                  </svg>
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="filter-empty" data-filter-empty hidden>No departures in this date range.</p>

      <div class="avail-pager" data-pager-nav hidden={pageCount <= 1}>
        <button type="button" class="pager-btn" data-avail-prev aria-label="Previous page">
          ‹
        </button>
        <span class="pager-status">
          Page <span data-avail-current>1</span> of <span data-avail-page-count>{pageCount}</span>
        </span>
        <button type="button" class="pager-btn" data-avail-next aria-label="Next page">
          ›
        </button>
      </div>

      <dialog class="booking-dialog" data-booking-dialog>
        <div class="dialog-head">
          <div>
            <h3>Book {shipName}</h3>
            <p class="dialog-departure">
              <span data-dialog-dates /> · <span data-dialog-price /> / person
            </p>
          </div>
          <button type="button" class="dialog-close" data-dialog-close aria-label="Close">
            ✕
          </button>
        </div>
        <BookingForm type="cruise" slug={shipSlug} />
      </dialog>
    </div>
  )
}

<script>
  import { addToCart, isInCart, itemKey, STORE_EVENT } from '../../scripts/cart-store';

  document.querySelectorAll<HTMLElement>('[data-avail-pager]').forEach((root) => {
    const shipSlug = root.dataset.shipSlug ?? '';
    const shipName = root.dataset.shipName ?? '';
    const shipHref = root.dataset.shipHref ?? '';
    const shipThumbnail = root.dataset.shipThumbnail || undefined;

    function paintCartButtons() {
      for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-add-departure]')) {
        const key = itemKey({ type: 'cruise', slug: shipSlug, departureStart: btn.dataset.start });
        const active = isInCart(key);
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      }
    }

    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-add-departure]')) {
      btn.addEventListener('click', () => {
        const departureStart = btn.dataset.start ?? '';
        const departureEnd = btn.dataset.end ?? '';
        const key = itemKey({ type: 'cruise', slug: shipSlug, departureStart });
        if (isInCart(key)) return; // quantity/removal happens in the cart drawer
        addToCart({
          type: 'cruise',
          slug: shipSlug,
          name: shipName,
          href: shipHref,
          thumbnail: shipThumbnail,
          departureStart,
          departureEnd,
          adults: 1,
          children: 0,
        });
      });
    }

    paintCartButtons();
    window.addEventListener(STORE_EVENT, paintCartButtons);
  });

  document.querySelectorAll<HTMLElement>('[data-avail-pager]').forEach((root) => {
    const tbody = root.querySelector<HTMLTableSectionElement>('tbody');
    const table = root.querySelector<HTMLTableElement>('.avail-table');
    const pageSize = Number(root.dataset.pageSize ?? 8);
    const allRows = Array.from(root.querySelectorAll<HTMLElement>('[data-avail-row]'));
    let rows = allRows; // current filtered + sorted set (drives pagination)
    let sortMode = 'date-asc';
    const currentEl = root.querySelector<HTMLElement>('[data-avail-current]');
    const pageCountEl = root.querySelector<HTMLElement>('[data-avail-page-count]');
    const pagerNav = root.querySelector<HTMLElement>('[data-pager-nav]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-avail-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-avail-next]');
    const emptyMsg = root.querySelector<HTMLElement>('[data-filter-empty]');
    const fromInput = root.querySelector<HTMLInputElement>('[data-filter-from]');
    const toInput = root.querySelector<HTMLInputElement>('[data-filter-to]');
    const applyBtn = root.querySelector<HTMLButtonElement>('[data-filter-apply]');
    let page = 0;

    function pageCount() {
      return rows.length === 0 ? 0 : Math.max(...rows.map((r) => Number(r.dataset.page ?? 0))) + 1;
    }

    function render() {
      rows.forEach((row) => {
        row.hidden = Number(row.dataset.page) !== page;
      });
      const count = pageCount();
      if (currentEl) currentEl.textContent = String(page + 1);
      if (pageCountEl) pageCountEl.textContent = String(count);
      if (prevBtn) prevBtn.disabled = page === 0;
      if (nextBtn) nextBtn.disabled = page >= count - 1;
      if (pagerNav) pagerNav.hidden = count <= 1;
    }

    function sortComparator(mode: string) {
      return (a: HTMLElement, b: HTMLElement) => {
        const aStart = a.dataset.departureStart ?? '';
        const bStart = b.dataset.departureStart ?? '';
        const aPrice = Number(a.dataset.departurePrice ?? 0);
        const bPrice = Number(b.dataset.departurePrice ?? 0);
        if (mode === 'price-asc') return aPrice - bPrice;
        if (mode === 'price-desc') return bPrice - aPrice;
        if (mode === 'date-desc') return bStart.localeCompare(aStart);
        return aStart.localeCompare(bStart);
      };
    }

    // Re-applies both the From/To date filter and the current sort mode over
    // the full row set. Filtering never re-fetches — it just shows/hides rows
    // already rendered from the cached 6-month window (see lib/availability.ts).
    function refresh() {
      const from = fromInput?.value ?? '';
      const to = toInput?.value ?? '';
      const visible = allRows.filter((r) => {
        const start = r.dataset.departureStart ?? '';
        return (!from || start >= from) && (!to || start <= to);
      });
      const sorted = [...visible].sort(sortComparator(sortMode));
      const visibleSet = new Set(sorted);
      allRows.forEach((r) => {
        if (!visibleSet.has(r)) r.hidden = true;
      });
      sorted.forEach((row, i) => {
        row.dataset.page = String(Math.floor(i / pageSize));
        tbody?.appendChild(row);
      });
      rows = sorted;
      page = 0;
      if (table) table.hidden = sorted.length === 0;
      if (emptyMsg) emptyMsg.hidden = sorted.length > 0;
      render();
    }

    prevBtn?.addEventListener('click', () => {
      if (page > 0) {
        page -= 1;
        render();
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (page < pageCount() - 1) {
        page += 1;
        render();
      }
    });

    applyBtn?.addEventListener('click', refresh);

    const sortPicker = root.querySelector<HTMLElement>('[data-sort-picker]');
    if (sortPicker) {
      const sortBtn = sortPicker.querySelector<HTMLButtonElement>('[data-sort-btn]')!;
      const sortList = sortPicker.querySelector<HTMLUListElement>('[data-sort-list]')!;
      const sortValueEl = sortBtn.querySelector<HTMLElement>('[data-sort-value]')!;
      const sortOptions = Array.from(sortList.querySelectorAll<HTMLLIElement>('[data-sort-option]'));

      function closeSort() {
        sortList.hidden = true;
        sortBtn.setAttribute('aria-expanded', 'false');
      }

      function openSort() {
        sortList.hidden = false;
        sortBtn.setAttribute('aria-expanded', 'true');
      }

      sortBtn.addEventListener('click', () => {
        if (sortList.hidden) openSort();
        else closeSort();
      });

      for (const option of sortOptions) {
        option.addEventListener('click', () => {
          sortMode = option.dataset.sortOption ?? 'date-asc';
          sortValueEl.textContent = option.textContent ?? '';
          for (const o of sortOptions) o.setAttribute('aria-selected', String(o === option));
          refresh();
          closeSort();
        });
      }

      document.addEventListener('click', (e) => {
        if (!sortPicker.contains(e.target as Node)) closeSort();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSort();
      });
    }

    render();
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-booking-dialog]');
  if (dialog) {
    const startInput = dialog.querySelector<HTMLInputElement>('[data-departure-start]')!;
    const datesEl = dialog.querySelector<HTMLElement>('[data-dialog-dates]')!;
    const priceEl = dialog.querySelector<HTMLElement>('[data-dialog-price]')!;

    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-book-departure]')) {
      btn.addEventListener('click', () => {
        startInput.value = btn.dataset.start ?? '';
        datesEl.textContent = btn.dataset.dates ?? '';
        priceEl.textContent = btn.dataset.price ?? '';
        dialog.showModal();
      });
    }

    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .no-departures {
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-soft);
  }

  .no-departures a {
    color: var(--brand-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .availability-down {
    border-color: var(--brand);
    color: var(--ink);
  }

  .avail-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .avail-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .avail-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.5rem 0.6rem;
  }

  .date-field,
  .sort-field {
    display: grid;
    gap: 0.25rem;
  }

  .date-field-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }

  .date-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.4rem 0.6rem;
    background: var(--white);
  }

  .date-input-wrap:focus-within {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .date-icon {
    width: 15px;
    height: 15px;
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .date-input-wrap input[type='date'] {
    border: none;
    padding: 0;
    background: transparent;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    width: 7.4rem;
  }

  .date-input-wrap input[type='date']:focus {
    outline: none;
  }

  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    white-space: nowrap;
  }

  .search-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .filter-empty {
    padding: 1.5rem 1.2rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .filter-empty[hidden] {
    display: none;
  }

  .sort-picker {
    position: relative;
  }

  .sort-picker-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.42rem 0.6rem;
    background: var(--white);
    cursor: pointer;
  }

  .sort-picker-btn:hover {
    border-color: var(--ink-soft);
  }

  .sort-picker-btn:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .sort-picker-btn[aria-expanded='true'] .sort-chevron {
    transform: rotate(180deg);
  }

  .sort-chevron {
    width: 14px;
    height: 14px;
    color: var(--ink-soft);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .sort-list {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 10;
    min-width: 100%;
    width: max-content;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-soft);
  }

  .sort-list[hidden] {
    display: none;
  }

  .sort-list li {
    padding: 0.5rem 0.7rem;
    border-radius: calc(var(--radius) - 4px);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }

  .sort-list li:hover,
  .sort-list li:focus-visible {
    background: var(--sand);
  }

  .sort-list li[aria-selected='true'] {
    background: rgba(78, 127, 254, 0.12);
    color: var(--brand-deep);
  }

  .avail-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
  }

  .avail-table th {
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--white);
    background: var(--brand);
    padding: 0.9rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .avail-table td {
    padding: 0.9rem 1.2rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .avail-table tr:last-child td {
    border-bottom: none;
  }

  .avail-pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--line);
  }

  .avail-pager[hidden] {
    display: none;
  }

  .pager-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--white);
    font-size: 1.1rem;
    color: var(--ink);
  }

  .pager-btn:hover:not(:disabled) {
    border-color: var(--brand);
    color: var(--brand-deep);
  }

  .pager-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .pager-status {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
    min-width: 7rem;
    text-align: center;
  }

  .promo-tag {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--white);
    background: var(--error);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .btn-sm {
    padding: 0.45rem 1rem;
    font-size: var(--text-xs);
  }

  .cart-row-btn {
    width: 34px;
    height: 34px;
  }

  .cart-row-btn svg {
    fill: none;
    transition: color 0.25s ease, fill 0.25s ease;
  }

  .cart-row-btn:hover,
  .cart-row-btn.is-active {
    color: var(--brand);
  }

  .cart-row-btn.is-active svg {
    fill: currentColor;
  }

  .booking-dialog {
    border: none;
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    width: min(92vw, 420px);
    box-shadow: var(--shadow-soft);
  }

  .booking-dialog::backdrop {
    background: rgba(16, 25, 46, 0.55);
  }

  .dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .dialog-head h3 {
    font-size: var(--text-lg);
  }

  .dialog-departure {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }

  .dialog-close {
    border: none;
    background: none;
    font-size: 1rem;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.25rem;
    line-height: 1;
  }

  .dialog-close:hover {
    color: var(--ink);
  }
</style>
