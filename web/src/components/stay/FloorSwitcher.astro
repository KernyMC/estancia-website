---
import type { StayFloor } from '../../lib/content';
import Lightbox from '../Lightbox.astro';

interface Props {
  floors: StayFloor[];
  stayName: string;
}

const { floors, stayName } = Astro.props;

/** Decorative, non-literal line icons keyed by keyword found in the amenity label. */
const AMENITY_ICONS: { match: RegExp; svg: string }[] = [
  {
    match: /wi-?fi/i,
    svg: '<path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>',
  },
  {
    match: /pool|infinity/i,
    svg: '<path d="M2 12c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M2 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>',
  },
  {
    match: /jacuzzi|hot tub|spa/i,
    svg: '<circle cx="7.5" cy="7.5" r="1.5"/><circle cx="14.5" cy="5.5" r="1"/><circle cx="11" cy="4" r="1"/><path d="M3 16c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>',
  },
  {
    match: /sauna/i,
    svg: '<path d="M6 21c0-2 2-2 2-4s-2-2-2-4 2-2 2-4"/><path d="M12 21c0-2 2-2 2-4s-2-2-2-4 2-2 2-4"/><path d="M18 21c0-2 2-2 2-4s-2-2-2-4 2-2 2-4"/>',
  },
  {
    match: /beach/i,
    svg: '<circle cx="12" cy="8" r="3"/><path d="M4.5 4.5 6 6M19.5 4.5 18 6"/><path d="M2 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>',
  },
  {
    match: /reception|concierge|front desk/i,
    svg: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
  },
  {
    match: /dining|breakfast|restaurant|kitchen/i,
    svg: '<path d="M6 2v7a2 2 0 0 0 4 0V2"/><path d="M8 9v13"/><path d="M18 2c-1.4 2.8-1.4 5.6 0 8.4V22"/>',
  },
  {
    match: /parking|garage/i,
    svg: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 16V7h3.5a3 3 0 0 1 0 6H9"/>',
  },
  {
    match: /air ?conditioning|\bac\b/i,
    svg: '<path d="M12 2v20M2 12h20M4.5 4.5l15 15M19.5 4.5l-15 15"/>',
  },
  {
    match: /washer|dryer|laundry/i,
    svg: '<rect x="4" y="2" width="16" height="20" rx="2"/><circle cx="12" cy="13" r="5"/><circle cx="8" cy="5" r="0.8"/><circle cx="11" cy="5" r="0.8"/>',
  },
  {
    match: /\btv\b|television|hdtv/i,
    svg: '<rect x="3" y="5" width="18" height="13" rx="2"/><path d="M9 21h6M12 18v3"/>',
  },
];

function amenityIcon(label: string): string {
  const found = AMENITY_ICONS.find((entry) => entry.match.test(label));
  return (
    found?.svg ??
    '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9"/>'
  );
}

const IMAGE_PLACEHOLDER_ICON =
  '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>';
---

<div class="floor-switcher" data-floor-switcher data-lightbox-root>
  <div class="floor-tabs" role="tablist" aria-label={`${stayName} floors`}>
    {
      floors.map((floor, i) => (
        <button
          type="button"
          class="floor-tab"
          class:list={{ active: i === 0 }}
          role="tab"
          aria-selected={i === 0}
          data-floor-tab={i}
        >
          {floor.tagline ? `${floor.tagline} · Floor ${i + 1}` : `Floor ${i + 1}`}
        </button>
      ))
    }
  </div>

  {
    floors.map((floor, i) => {
      const pairs = Array.from({ length: Math.min(2, Math.max(floor.bedrooms.length, floor.bathroomPhotos.length)) }).map(
        (_, idx) => ({
          room: floor.bedrooms[idx] ?? null,
          bath: floor.bathroomPhotos[idx] ?? null,
        }),
      );

      return (
        <div class="floor-panel" class:list={{ active: i === 0 }} role="tabpanel" data-floor-panel={i} data-lightbox-group>
          <div class="photo-grid">
            <div class="photo-cell main-cell">
              {floor.mainPhoto ? (
                <img src={floor.mainPhoto} alt={`${stayName}, ${floor.name} main photo`} loading="lazy" class="lightbox-trigger" tabindex="0" role="button" />
              ) : (
                <div class="photo-cell-empty">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={IMAGE_PLACEHOLDER_ICON} />
                  <span class="cell-label-primary">Main photo</span>
                </div>
              )}
            </div>

            {pairs.length > 0 && (
              <div class="photo-side">
                {pairs.map((pair) => (
                  <div class="photo-side-row">
                    <div class="photo-cell room-cell">
                      {pair.room?.photo ? (
                        <img src={pair.room.photo} alt={`${stayName}, ${floor.name}, ${pair.room.name}`} loading="lazy" class="lightbox-trigger" tabindex="0" role="button" />
                      ) : (
                        <div class="photo-cell-empty">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={IMAGE_PLACEHOLDER_ICON} />
                          <span class="cell-label-primary">Room photo</span>
                          {pair.room?.name && <span class="cell-label-secondary">{pair.room.name}</span>}
                        </div>
                      )}
                    </div>
                    <div class="photo-cell bath-cell">
                      {pair.bath?.image ? (
                        <img src={pair.bath.image} alt={`${stayName}, ${floor.name}, ${pair.bath.label}`} loading="lazy" class="lightbox-trigger" tabindex="0" role="button" />
                      ) : (
                        <div class="photo-cell-empty">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={IMAGE_PLACEHOLDER_ICON} />
                          <span class="cell-label-primary">Bathroom</span>
                          {pair.bath?.label && <span class="cell-label-secondary">{pair.bath.label}</span>}
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          {floor.otherRooms.length > 0 && (
            <div class="other-rooms">
              {floor.otherRooms.map((room) => (
                <figure class="other-room-card">
                  <div class="other-room-photo">
                    {room.photo ? (
                      <img
                        src={room.photo}
                        alt={room.description ?? `${stayName}, ${floor.name}, extra room`}
                        loading="lazy"
                        class="lightbox-trigger"
                        tabindex="0"
                        role="button"
                      />
                    ) : (
                      <div class="photo-cell-empty">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={IMAGE_PLACEHOLDER_ICON} />
                      </div>
                    )}
                  </div>
                  {room.description && <figcaption>{room.description}</figcaption>}
                </figure>
              ))}
            </div>
          )}

          <div class="floor-footer">
            <div class="floor-text">
              <h3>{floor.name}</h3>
              {floor.description && <p>{floor.description}</p>}
              <ul class="floor-meta">
                {floor.capacity && <li>{floor.capacity} guests</li>}
                {floor.bedrooms.length > 0 && <li>{floor.bedrooms.length} bedrooms</li>}
                {floor.bathrooms && <li>{floor.bathrooms} bathrooms</li>}
              </ul>
            </div>

            <div class="floor-side">
              {floor.amenities.length > 0 && (
                <ul class="floor-amenity-icons">
                  {floor.amenities.map((a) => (
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={amenityIcon(a)} />
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>
              )}

              {floor.airbnbUrl && (
                <a class="btn check-availability" href={floor.airbnbUrl} target="_blank" rel="noopener">
                  <img src="/logos/air-bnb-logo.svg" alt="" loading="lazy" class="airbnb-logo" />
                  Check Availability on Airbnb
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>
      );
    })
  }

  <Lightbox />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-floor-switcher]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.floor-tab');
    const panels = root.querySelectorAll<HTMLElement>('.floor-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.dataset.floorTab;
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => p.classList.toggle('active', p.dataset.floorPanel === idx));
      });
    });
  });
</script>

<style>
  .floor-tabs {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.25rem);
    overflow-x: auto;
    padding-bottom: 0.9rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .floor-tab {
    flex: 0 0 auto;
    appearance: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.2rem 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .floor-tab:hover {
    color: var(--ink);
  }

  .floor-tab.active {
    color: var(--brand-deep);
    border-bottom-color: var(--brand-deep);
  }

  .floor-panel {
    display: none;
  }

  .floor-panel.active {
    display: block;
  }

  .photo-grid {
    display: flex;
    gap: 0.75rem;
    height: clamp(300px, 34vw, 400px);
  }

  .photo-cell {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--sand);
    min-width: 0;
  }

  .photo-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lightbox-trigger {
    cursor: pointer;
  }

  .lightbox-trigger:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .main-cell {
    flex: 1.5;
  }

  .photo-side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .photo-side-row {
    flex: 1;
    display: flex;
    gap: 0.75rem;
    min-height: 0;
  }

  .room-cell,
  .bath-cell {
    flex: 1;
  }

  .photo-cell-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.75rem;
    text-align: center;
    color: var(--ink-soft);
  }

  .photo-cell-empty svg {
    width: 24px;
    height: 24px;
    opacity: 0.5;
  }

  .cell-label-primary {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--ink-soft);
  }

  .cell-label-secondary {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    opacity: 0.75;
  }

  .other-rooms {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    margin-top: 1rem;
    padding-bottom: 0.25rem;
  }

  .other-room-card {
    flex: 0 0 160px;
    margin: 0;
  }

  .other-room-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--sand);
  }

  .other-room-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .other-room-card figcaption {
    margin-top: 0.5rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .floor-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .floor-text {
    flex: 1;
    min-width: 220px;
  }

  .floor-text h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .floor-text p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.65;
    max-width: 46ch;
  }

  .floor-meta {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: var(--text-sm);
    font-weight: 620;
  }

  .floor-meta li:not(:last-child)::after {
    content: '·';
    margin-left: 1rem;
    color: var(--line);
  }

  .floor-side {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
    min-width: 280px;
  }

  .floor-amenity-icons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .floor-amenity-icons li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    max-width: 5.5rem;
    text-align: center;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .floor-amenity-icons svg {
    width: 22px;
    height: 22px;
    color: var(--brand-deep);
  }

  .check-availability {
    width: 100%;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    background: #ff385c;
    color: var(--white);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .check-availability:hover {
    background: #e31c5f;
  }

  .check-availability svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .airbnb-logo {
    width: 30px;
    height: 30px;
    display: block;
    flex-shrink: 0;
    filter: brightness(0) invert(1);
  }

  @media (max-width: 780px) {
    .photo-grid {
      flex-direction: column;
      height: auto;
    }

    .main-cell {
      aspect-ratio: 4 / 3;
    }

    .room-cell,
    .bath-cell {
      aspect-ratio: 3 / 2;
    }

    .floor-side {
      align-items: stretch;
      width: 100%;
      min-width: 0;
    }

    .floor-amenity-icons {
      justify-content: flex-start;
    }
  }

</style>
