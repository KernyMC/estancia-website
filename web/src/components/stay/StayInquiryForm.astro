---
/**
 * Stay availability inquiry — same dialog+POST /api/inquiry pattern used
 * elsewhere on the site (stays have no live calendar), trimmed down: no
 * add-ons fieldset, dates read as check-in/check-out. Replaces the old
 * "Ask about availability" link to /contact/?stay=... — same backend, no new
 * moving parts, just skips the generic contact page.
 */
import { countryCodes, defaultCountry } from '../../lib/phone-codes';
import PrivacyPolicyContent from '../PrivacyPolicyContent.astro';
import type { Stay } from '../../lib/content';

interface Props {
  stay: Stay;
}

const { stay } = Astro.props;
const MESSAGE_MAX_LENGTH = 1000;
---

<button type="button" class="btn btn-primary inquiry-trigger" data-inquiry-open>
  <span class="inquiry-trigger-ring" aria-hidden="true"></span>
  Ask about availability
</button>
<p class="inquiry-hint">Tell us your dates and group size, no payment now.</p>

<dialog class="inquiry-dialog" data-inquiry-dialog aria-label={`Ask about availability at ${stay.name}`}>
  <div class="dialog-head">
    <div>
      <h3>Ask about {stay.name}</h3>
      <p class="dialog-sub">We'll follow up by email with real availability.</p>
    </div>
    <button type="button" class="dialog-close" data-dialog-close aria-label="Close">✕</button>
  </div>

  <form class="inquiry-form" data-inquiry-form>
  <input type="hidden" name="context" value={`Stay inquiry: ${stay.name}`} />

  <div class="field-row">
    <label class="field">
      <span>Full name</span>
      <input type="text" name="name" required maxlength="200" autocomplete="name" />
    </label>
    <label class="field">
      <span>Email</span>
      <input type="email" name="email" required maxlength="320" autocomplete="email" />
    </label>
  </div>

  <label class="field">
    <span>Phone <em>(optional)</em></span>
    <div class="phone-row">
      <div class="phone-code-picker" data-phone-picker>
        <button type="button" class="phone-code-btn" data-phone-btn aria-haspopup="listbox" aria-expanded="false">
          <img class="phone-flag" data-phone-flag src={`https://flagcdn.com/${defaultCountry.iso}.svg`} alt="" width="20" height="15" />
          <span data-phone-dial>{defaultCountry.dial}</span>
          <svg class="phone-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div class="phone-code-panel" data-phone-panel hidden>
          <input
            type="text"
            class="phone-code-search"
            data-phone-search
            placeholder="Search country…"
            autocomplete="off"
            aria-label="Search country"
          />
          <ul class="phone-code-list" data-phone-list role="listbox">
            {countryCodes.map((c) => (
              <li role="option" data-dial={c.dial} data-iso={c.iso} data-name={c.name} data-search={`${c.name} ${c.dial}`.toLowerCase()} tabindex="-1">
                <img src={`https://flagcdn.com/${c.iso}.svg`} alt="" width="20" height="15" loading="lazy" />
                <span class="phone-opt-name">{c.name}</span>
                <span class="phone-opt-dial">{c.dial}</span>
              </li>
            ))}
          </ul>
          <p class="phone-code-empty" data-phone-empty hidden>No matches</p>
        </div>
        <input type="hidden" name="phoneCode" value={defaultCountry.dial} data-phone-input />
      </div>
      <input type="tel" name="phone" maxlength="30" autocomplete="tel-national" placeholder="99 123 4567" />
    </div>
  </label>

  <div class="field-row">
    <label class="field">
      <span>Check-in <em>(optional)</em></span>
      <span class="date-input-wrap">
        <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M3 10h18M8 2v4M16 2v4" />
        </svg>
        <input type="date" name="startDate" />
      </span>
    </label>
    <label class="field">
      <span>Check-out <em>(optional)</em></span>
      <span class="date-input-wrap">
        <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M3 10h18M8 2v4M16 2v4" />
        </svg>
        <input type="date" name="endDate" />
      </span>
    </label>
  </div>

  <div class="field-row">
    <label class="field">
      <span>Guests <em>(optional)</em></span>
      <input type="number" name="travelers" inputmode="numeric" min="1" max="50" step="1" placeholder="e.g. 2" />
    </label>
    <label class="field">
      <span>Country of origin <em>(optional)</em></span>
      <div class="origin-picker" data-origin-picker>
        <div class="origin-input-wrap">
          <img class="origin-flag" data-origin-flag hidden alt="" width="20" height="15" />
          <input type="text" name="originCountry" data-origin-input autocomplete="off" placeholder={defaultCountry.name} />
          <svg class="origin-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </div>
        <ul class="origin-list" data-origin-list role="listbox" hidden>
          {countryCodes.map((c) => (
            <li role="option" data-name={c.name} data-iso={c.iso} data-search={c.name.toLowerCase()} tabindex="-1">
              <img src={`https://flagcdn.com/${c.iso}.svg`} alt="" width="20" height="15" loading="lazy" />
              <span>{c.name}</span>
            </li>
          ))}
        </ul>
        <p class="origin-empty" data-origin-empty hidden>No match, we'll use what you typed</p>
      </div>
    </label>
  </div>

  <label class="field">
    <span class="field-label-row">
      Comments <em>(optional)</em>
      <span class="char-count" data-char-count>0/{MESSAGE_MAX_LENGTH}</span>
    </span>
    <div class="message-wrap">
      <div class="message-backdrop" data-message-backdrop aria-hidden="true"></div>
      <textarea
        name="message"
        rows="3"
        placeholder="Anything else we should know?"
        data-char-count-input
        data-max-length={MESSAGE_MAX_LENGTH}
      ></textarea>
    </div>
  </label>

  <p class="form-error" data-form-error hidden></p>

  <label class="consent-row">
    <input type="checkbox" name="consent" required data-consent-input />
    <span>
      I agree to the
      <button type="button" class="privacy-link" data-privacy-open>privacy policy</button>
    </span>
  </label>

  <button type="submit" class="btn btn-primary submit-btn" data-submit-btn disabled>
    <span class="btn-spinner" data-submit-spinner hidden aria-hidden="true"></span>
    <span data-submit-label>Send inquiry</span>
  </button>
  <p class="secure-note">No payment now, our team confirms real dates and follows up by email.</p>
  </form>
</dialog>

<dialog class="privacy-dialog" data-privacy-dialog aria-label="Privacy policy">
  <div class="privacy-dialog-head">
    <h2>Privacy Policy</h2>
    <button type="button" class="privacy-dialog-close" data-privacy-close aria-label="Close">✕</button>
  </div>
  <div class="privacy-dialog-body prose">
    <PrivacyPolicyContent />
  </div>
  <p class="privacy-dialog-footer">
    <a href="/privacy/" target="_blank" rel="noopener">Open full page in a new tab</a>
  </p>
</dialog>

<script>
  import { wirePhoneCodePicker, buildPhoneValue } from '../../scripts/phone-code-picker';

  const inquiryOpenBtn = document.querySelector<HTMLButtonElement>('[data-inquiry-open]');
  const inquiryDialog = document.querySelector<HTMLDialogElement>('[data-inquiry-dialog]');
  inquiryOpenBtn?.addEventListener('click', () => inquiryDialog?.showModal());
  inquiryDialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => inquiryDialog.close());
  inquiryDialog?.addEventListener('click', (e) => {
    if (e.target === inquiryDialog) inquiryDialog.close();
  });

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]')) {
    wirePhoneCodePicker(form);

    // Country-of-origin combobox: same flag+searchable-list UX as the phone
    // code picker, but the input itself is the search field and stays
    // free-typeable — picking a list item just fills it in, it doesn't
    // constrain what can be submitted (see requirements 2026-08-02).
    for (const picker of form.querySelectorAll<HTMLElement>('[data-origin-picker]')) {
      const input = picker.querySelector<HTMLInputElement>('[data-origin-input]')!;
      const flagImg = picker.querySelector<HTMLImageElement>('[data-origin-flag]')!;
      const list = picker.querySelector<HTMLUListElement>('[data-origin-list]')!;
      const empty = picker.querySelector<HTMLElement>('[data-origin-empty]')!;
      const options = Array.from(list.querySelectorAll<HTMLLIElement>('li'));

      const filter = (query: string) => {
        const q = query.trim().toLowerCase();
        let visibleCount = 0;
        for (const option of options) {
          const matches = !q || (option.dataset.search ?? '').includes(q);
          option.hidden = !matches;
          if (matches) visibleCount += 1;
        }
        empty.hidden = visibleCount > 0;
      };

      const openList = () => {
        list.hidden = false;
        filter(input.value);
      };
      const closeList = () => {
        list.hidden = true;
      };

      const syncFlag = () => {
        const match = options.find((o) => (o.dataset.name ?? '').toLowerCase() === input.value.trim().toLowerCase());
        flagImg.hidden = !match;
        if (match) flagImg.src = `https://flagcdn.com/${match.dataset.iso}.svg`;
      };

      const selectOption = (option: HTMLLIElement) => {
        input.value = option.dataset.name ?? '';
        flagImg.src = `https://flagcdn.com/${option.dataset.iso}.svg`;
        flagImg.hidden = false;
        closeList();
      };

      input.addEventListener('focus', openList);
      input.addEventListener('click', openList);
      input.addEventListener('input', () => {
        openList();
        syncFlag();
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeList();
        } else if (e.key === 'Enter' && !list.hidden) {
          // Handled here, not the form-wide "Enter advances field" listener —
          // Enter should confirm the highlighted match first.
          e.preventDefault();
          e.stopPropagation();
          const firstVisible = options.find((o) => !o.hidden);
          if (firstVisible) selectOption(firstVisible);
          else closeList();
        }
      });

      for (const option of options) {
        option.addEventListener('click', (e) => {
          // The list sits inside the field's <label>, so a plain click also
          // triggers the browser's label->control delegation, refocusing the
          // input and reopening the list right after closeList() runs.
          // preventDefault() suppresses that delegated activation.
          e.preventDefault();
          selectOption(option);
        });
      }

      document.addEventListener('click', (e) => {
        if (!picker.contains(e.target as Node)) closeList();
      });
    }

    // Enter moves to the next field instead of submitting — this is a long
    // form and users expect Enter to behave like Tab, not "I'm done".
    // Textareas keep Enter as a real newline; buttons keep their own click.
    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const target = e.target as HTMLElement;
      if (target.tagName === 'TEXTAREA' || target.tagName === 'BUTTON') return;

      e.preventDefault();
      const focusable = Array.from(
        form.querySelectorAll<HTMLElement>('input, select, textarea, button')
      ).filter((el) => el.offsetParent !== null && !(el as HTMLInputElement).disabled);
      const index = focusable.indexOf(target);
      focusable[index + 1]?.focus();
    });

    const errorEl = form.querySelector<HTMLElement>('[data-form-error]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit-btn]')!;
    const consentInput = form.querySelector<HTMLInputElement>('[data-consent-input]');
    const messageInput = form.querySelector<HTMLTextAreaElement>('[data-char-count-input]');
    const messageBackdrop = form.querySelector<HTMLElement>('[data-message-backdrop]');
    const charCount = form.querySelector<HTMLElement>('[data-char-count]');

    let messageOverLimit = false;

    const syncSubmitState = () => {
      submitBtn.disabled = !consentInput?.checked || messageOverLimit;
    };

    // No native maxlength — typing past the limit stays possible, but the
    // overflow renders in red (via a same-size backdrop <div> sitting behind
    // the now-transparent-text textarea) and submit stays disabled until the
    // guest trims back down. Kept in sync with the server cap in
    // src/pages/api/inquiry.ts (z.string().max(1000)).
    if (messageInput && messageBackdrop && charCount) {
      const max = Number(messageInput.dataset.maxLength ?? 1000);
      const escapeHtml = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      const render = () => {
        const value = messageInput.value;
        messageOverLimit = value.length > max;
        messageBackdrop.innerHTML = messageOverLimit
          ? `${escapeHtml(value.slice(0, max))}<span class="message-overflow">${escapeHtml(value.slice(max))}</span>`
          : escapeHtml(value);
        charCount.textContent = `${value.length}/${max}`;
        charCount.classList.toggle('is-over', messageOverLimit);
        syncSubmitState();
      };

      messageInput.addEventListener('input', render);
      messageInput.addEventListener('scroll', () => {
        messageBackdrop.scrollTop = messageInput.scrollTop;
      });
      render();
    }

    consentInput?.addEventListener('change', syncSubmitState);
    syncSubmitState();

    const privacyDialog = document.querySelector<HTMLDialogElement>('[data-privacy-dialog]');
    const privacyOpenBtn = form.querySelector<HTMLButtonElement>('[data-privacy-open]');
    const privacyCloseBtn = privacyDialog?.querySelector<HTMLButtonElement>('[data-privacy-close]');
    privacyOpenBtn?.addEventListener('click', () => privacyDialog?.showModal());
    privacyCloseBtn?.addEventListener('click', () => privacyDialog?.close());
    privacyDialog?.addEventListener('click', (e) => {
      if (e.target === privacyDialog) privacyDialog.close();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (messageOverLimit) return;
      errorEl.hidden = true;

      const data = new FormData(form);
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        phone: buildPhoneValue(data),
        travelers: data.get('travelers') || undefined,
        startDate: data.get('startDate') || undefined,
        endDate: data.get('endDate') || undefined,
        originCountry: data.get('originCountry') || undefined,
        message: (data.get('message') as string)?.trim() ?? '',
        context: data.get('context') || undefined,
      };

      const submitLabel = submitBtn.querySelector<HTMLElement>('[data-submit-label]');
      const submitSpinner = submitBtn.querySelector<HTMLElement>('[data-submit-spinner]');
      const idleLabel = submitLabel?.textContent ?? '';
      submitBtn.disabled = true;
      if (submitSpinner) submitSpinner.hidden = false;
      if (submitLabel) submitLabel.textContent = 'Sending…';

      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('failed');

        // Brief green "Sent" confirmation on the button itself before the
        // form collapses into the full success message below it.
        if (submitSpinner) submitSpinner.hidden = true;
        if (submitLabel) submitLabel.textContent = 'Sent ✓';
        submitBtn.classList.add('is-sent');
        await new Promise((resolve) => setTimeout(resolve, 900));

        form.hidden = true;
        const success = document.createElement('p');
        success.className = 'inquiry-success';
        success.textContent = "Thanks, we've received your request and will follow up by email with real availability.";
        form.insertAdjacentElement('afterend', success);
      } catch {
        errorEl.textContent = 'Something went wrong. Please try again or email us directly.';
        errorEl.hidden = false;
        if (submitSpinner) submitSpinner.hidden = true;
        if (submitLabel) submitLabel.textContent = idleLabel;
        syncSubmitState();
      }
    });
  }
</script>

<style>
  .inquiry-trigger {
    position: relative;
    width: 100%;
    justify-content: center;
    margin-top: 1.25rem;
    transition: scale 0.15s ease;
  }

  .inquiry-trigger:hover {
    scale: 1.02;
  }

  .inquiry-trigger:active {
    scale: 0.96;
  }

  /* Expanding-ring hover cue — CSS equivalent of a Framer Motion
     whileHover/AnimatePresence pulse, no extra runtime needed for one
     button. Re-fires every hover-enter since :hover toggling restarts the
     keyframe animation in all evergreen browsers. */
  .inquiry-trigger-ring {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.7);
    opacity: 0;
    pointer-events: none;
  }

  .inquiry-trigger:hover .inquiry-trigger-ring {
    animation: inquiry-ring-pulse 0.6s ease-out;
  }

  @keyframes inquiry-ring-pulse {
    0% {
      opacity: 1;
      scale: 1;
    }
    100% {
      opacity: 0;
      scale: 1.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inquiry-trigger {
      transition: none;
    }
    .inquiry-trigger:hover,
    .inquiry-trigger:active {
      scale: 1;
    }
    .inquiry-trigger:hover .inquiry-trigger-ring {
      animation: none;
    }
  }

  .inquiry-hint {
    margin-top: 0.6rem;
    text-align: center;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .inquiry-dialog {
    border: none;
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    width: min(92vw, 640px);
    max-height: min(92vh, 860px);
    overflow-y: auto;
    box-shadow: var(--shadow-soft);
  }

  .inquiry-dialog[open] {
    display: block;
  }

  .inquiry-dialog::backdrop {
    background: rgba(16, 25, 46, 0.55);
  }

  .dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .dialog-head h3 {
    font-size: var(--text-lg);
  }

  .dialog-sub {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }

  .dialog-close {
    border: none;
    background: none;
    font-size: 1rem;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .dialog-close:hover {
    color: var(--ink);
  }

  .inquiry-form {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
    min-width: 0;
  }

  /* The class above sets display:grid with author-stylesheet weight, which
     otherwise beats the browser's built-in [hidden]{display:none} rule —
     form.hidden = true (see the submit handler) would silently do nothing
     without this (found 2026-08-02, same bug as .avail-pager[hidden] in
     AvailabilityTable.astro). */
  .inquiry-form[hidden] {
    display: none;
  }

  .inquiry-success {
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--success) 12%, white);
    color: var(--success);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    min-width: 0;
  }

  .field {
    display: grid;
    gap: 0.3rem;
    font-size: var(--text-sm);
    min-width: 0;
  }

  .field > span {
    font-weight: 600;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .field em {
    font-style: normal;
    text-transform: none;
    font-weight: 400;
  }

  .field-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .char-count {
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink-soft);
  }

  .field input:not([type='radio']):not([type='date']):not([data-origin-input]),
  .field textarea {
    width: 100%;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
    background: var(--white);
  }

  .field textarea {
    resize: vertical;
  }

  .field input:not([type='radio']):not([type='date']):not([data-origin-input]):focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  /* Overflow-highlighted textarea: a same-box-model backdrop <div> sits
     behind the textarea and renders the real (colored) text; the textarea
     itself keeps typing/selection/scroll working but its own text is
     transparent, so only the backdrop's version is ever visible. */
  .message-wrap {
    position: relative;
  }

  .message-backdrop,
  .field .message-wrap textarea {
    box-sizing: border-box;
    min-height: 4.5rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .message-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--ink);
    background: var(--white);
    pointer-events: none;
  }

  .field .message-wrap textarea {
    position: relative;
    width: 100%;
    background: transparent;
    color: transparent;
    caret-color: var(--ink);
    resize: none;
  }

  .field .message-wrap textarea:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  /* :global() — this span is created via innerHTML at runtime (see the
     <script> below), so it never receives Astro's scoped data-astro-cid
     attribute; a scoped selector would silently never match it (same fix as
     :global(.lightbox-thumb) in Lightbox.astro). */
  :global(.message-overflow) {
    color: var(--error);
    background: color-mix(in srgb, var(--error) 14%, transparent);
    border-radius: 2px;
  }

  .char-count.is-over {
    color: var(--error);
    font-weight: 700;
  }

  /* Native date inputs render an unstyled system calendar icon that clashes
     with the rest of the form — same box treatment as the icon-prefixed date
     fields in AvailabilityTable, for visual consistency across the site. */
  .date-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.55rem 0.7rem;
    background: var(--white);
  }

  .date-input-wrap:focus-within {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .date-icon {
    width: 15px;
    height: 15px;
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .date-input-wrap input[type='date'] {
    width: 100%;
    min-width: 0;
    border: none;
    padding: 0;
    background: transparent;
    font: inherit;
    color: var(--ink);
  }

  .date-input-wrap input[type='date']:focus {
    outline: none;
  }

  .phone-row {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
  }

  .phone-row input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .phone-code-picker {
    position: relative;
    flex: 0 0 auto;
  }

  .phone-code-btn {
    display: flex;
