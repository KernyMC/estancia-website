---
import type { StayRoom } from '../../lib/content';

interface Props {
  rooms: StayRoom[];
  stayName: string;
}

const { rooms, stayName } = Astro.props;
---

<ul class="room-grid">
  {
    rooms.map((room, i) => {
      const cover = room.gallery[0] ?? null;
      const photoCount = room.gallery.length;
      return (
        <li>
          <button type="button" class="room-card" data-room-open={i} aria-haspopup="dialog">
            <span class="room-photo">
              {cover ? (
                <img src={cover} alt={`${stayName}, ${room.name}`} loading="lazy" />
              ) : (
                <span class="room-photo-empty">Photos coming soon</span>
              )}
              {photoCount > 1 && <span class="room-photo-count">{photoCount} photos</span>}
            </span>
            <span class="room-card-body">
              <span class="room-name">{room.name}</span>
              {(room.capacity || room.beds) && (
                <span class="room-meta">
                  {room.capacity && <>{room.capacity} guests</>}
                  {room.capacity && room.beds && ' · '}
                  {room.beds}
                </span>
              )}
            </span>
          </button>
        </li>
      );
    })
  }
</ul>

{
  rooms.map((room, i) => (
    <dialog class="room-dialog" data-room-dialog={i}>
      <div class="dialog-head">
        <h3>{room.name}</h3>
        <button type="button" class="dialog-close" data-room-dialog-close aria-label="Close">
          ✕
        </button>
      </div>

      {room.gallery.length > 0 ? (
        <div class="room-dialog-gallery">
          <img class="room-dialog-main" data-room-main src={room.gallery[0]} alt={`${stayName}, ${room.name}`} />
          {room.gallery.length > 1 && (
            <div class="room-dialog-thumbs">
              {room.gallery.map((src) => (
                <button type="button" class="room-thumb" data-room-thumb data-src={src}>
                  <img src={src} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>
      ) : (
        <p class="room-dialog-empty">Photos for this room are coming soon.</p>
      )}

      {room.description && <p class="room-dialog-desc">{room.description}</p>}

      {(room.capacity || room.beds) && (
        <p class="room-dialog-meta">
          {room.capacity && <>{room.capacity} guests</>}
          {room.capacity && room.beds && ' · '}
          {room.beds}
        </p>
      )}

      {room.amenities.length > 0 && (
        <ul class="room-amenity-list">
          {room.amenities.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      )}
    </dialog>
  ))
}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-room-open]').forEach((btn) => {
    const idx = btn.dataset.roomOpen;
    const dialog = document.querySelector<HTMLDialogElement>(`[data-room-dialog="${idx}"]`);
    if (!dialog) return;

    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-room-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    const main = dialog.querySelector<HTMLImageElement>('[data-room-main]');
    const thumbs = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-room-thumb]'));
    let mainIndex = 0;

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => {
        mainIndex = i;
        if (main && thumb.dataset.src) main.src = thumb.dataset.src;
      });
    });

    // Swipe left/right on the main photo to move through the room gallery.
    if (main && thumbs.length > 1) {
      const SWIPE_THRESHOLD = 40;
      let touchStartX = 0;

      main.addEventListener('touchstart', (e: TouchEvent) => { touchStartX = e.touches[0].clientX; }, { passive: true });
      main.addEventListener(
        'touchend',
        (e: TouchEvent) => {
          const dx = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) < SWIPE_THRESHOLD) return;
          mainIndex = (mainIndex + (dx < 0 ? 1 : -1) + thumbs.length) % thumbs.length;
          const src = thumbs[mainIndex].dataset.src;
          if (src) main.src = src;
        },
        { passive: true },
      );
    }
  });
</script>

<style>
  .room-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 340px));
    justify-content: start;
    gap: 1.25rem;
  }

  .room-card {
    display: block;
    width: 100%;
    padding: 0;
    text-align: left;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    transition: box-shadow 0.25s ease, translate 0.25s ease;
  }

  .room-card:hover {
    box-shadow: var(--shadow-soft);
    translate: 0 -3px;
  }

  .room-photo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--sand);
  }

  .room-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .room-photo-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-align: center;
    padding: 1rem;
  }

  .room-photo-count {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    background: rgba(16, 25, 46, 0.72);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  .room-card-body {
    display: block;
    padding: 1rem 1.1rem 1.2rem;
  }

  .room-name {
    display: block;
    font-size: var(--text-lg);
    font-weight: 650;
  }

  .room-meta {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .room-dialog {
    border: none;
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    width: min(92vw, 640px);
    max-height: 88dvh;
    overflow-y: auto;
    box-shadow: var(--shadow-soft);
  }

  .room-dialog::backdrop {
    background: rgba(16, 25, 46, 0.55);
  }

  .dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .dialog-head h3 {
    font-size: var(--text-xl);
  }

  .dialog-close {
    border: none;
    background: none;
    font-size: 1rem;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.25rem;
    line-height: 1;
  }

  .dialog-close:hover {
    color: var(--ink);
  }

  .room-dialog-gallery {
    margin-top: 1.1rem;
  }

  .room-dialog-main {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .room-dialog-thumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
    overflow-x: auto;
  }

  .room-thumb {
    flex: 0 0 auto;
    width: 64px;
    height: 48px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
  }

  .room-thumb:hover {
    border-color: var(--brand);
  }

  .room-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .room-dialog-empty {
    margin-top: 1.1rem;
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    text-align: center;
  }

  .room-dialog-desc {
    margin-top: 1.1rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .room-dialog-meta {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .room-amenity-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .room-amenity-list li {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--sand);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
</style>
