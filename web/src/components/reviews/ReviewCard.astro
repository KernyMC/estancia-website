---
import type { Review } from '../../lib/content';
import { urlFor } from '../../lib/sanity';
import { getReviewSource } from '../../lib/reviewSources';

interface Props {
  review: Review;
}

const { review } = Astro.props;
const source = getReviewSource(review.source);
const initial = review.author.trim().charAt(0).toUpperCase() || '?';

const photoUrl = review.guestPhoto
  ? urlFor(review.guestPhoto).width(96).height(96).fit('crop').auto('format').url()
  : null;

const dateLabel = review.date
  ? new Date(review.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : '';

const TEXT_LIMIT = 220;
const isLong = review.text.length > TEXT_LIMIT;
const displayText = isLong ? `${review.text.slice(0, TEXT_LIMIT).trimEnd()}…` : review.text;
---

<li class="review-card">
  <div class="review-top">
    <div class="review-stars" aria-label={`${review.rating} out of 5 stars`}>
      {'★'.repeat(review.rating)}<span class="star-empty">{'★'.repeat(5 - review.rating)}</span>
    </div>
    {
      source.logo ? (
        <img class="source-logo" src={source.logo} alt={`Reviewed on ${source.label}`} width={source.w} height={source.h} loading="lazy" />
      ) : (
        <span class="source-label">{source.label}</span>
      )
    }
  </div>

  <p class="review-text">
    “{displayText}”
    {
      isLong && review.link && (
        <a class="review-more" href={review.link} target="_blank" rel="noopener noreferrer">
          See more
        </a>
      )
    }
  </p>

  <div class="review-foot">
    {
      photoUrl ? (
        <img class="avatar" src={photoUrl} alt={review.author} width="44" height="44" loading="lazy" />
      ) : (
        <span class="avatar avatar-initial" aria-hidden="true">{initial}</span>
      )
    }
    <div class="review-meta">
      <span class="review-author">{review.author}</span>
      <span class="review-sub">
        {dateLabel}
        {review.stayName && <> · {review.stayName}</>}
      </span>
    </div>
    {
      review.link && (
        <a class="review-link" href={review.link} target="_blank" rel="noopener noreferrer">
          <span class="visually-hidden">Read on {source.label}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </a>
      )
    }
  </div>
</li>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius);
    background: var(--sand);
  }

  .review-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .review-stars {
    color: var(--brand);
    letter-spacing: 0.05em;
    font-size: var(--text-sm);
  }

  .star-empty {
    color: color-mix(in srgb, var(--brand) 28%, transparent);
  }

  .source-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
    border-radius: 4px;
  }

  .source-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .review-text {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.45;
    flex-grow: 1;
  }

  .review-more {
    display: inline-block;
    margin-left: 0.35rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--brand-deep);
    white-space: nowrap;
  }

  .review-more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .review-foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .avatar-initial {
    display: grid;
    place-items: center;
    background: var(--brand);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.1rem;
    line-height: 1;
  }

  .review-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .review-author {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--ink);
  }

  .review-sub {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .review-link {
    margin-left: auto;
    display: inline-flex;
    padding: 0.4rem;
    color: var(--ink-soft);
    border-radius: 8px;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .review-link:hover {
    background: var(--white);
    color: var(--brand-deep);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
