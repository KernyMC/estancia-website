---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { withBrand, absoluteUrl, organizationLd, jsonLdScript, SITE_NAME } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Site-relative canonical path. Defaults to the current request path. */
  canonical?: string;
  /** Site-relative or absolute OG/Twitter image. */
  image?: string;
  /** One or more schema.org JSON-LD objects to embed. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Skip the automatic "| Galápagos & Beyond" title suffix. */
  noBrand?: boolean;
}

const { title, description, canonical, image, jsonLd, noBrand } = Astro.props;

const fullTitle = noBrand ? title : withBrand(title);
const canonicalUrl = absoluteUrl(canonical ?? Astro.url.pathname);
const ogImage = image ? absoluteUrl(image) : undefined;

// Organization is always present; page-supplied blocks come after it.
const ldBlocks = [organizationLd(), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {/* Must match --brand in global.css — meta tags can't read CSS variables */}
    <meta name="theme-color" content="#4e7ffe" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <title>{fullTitle}</title>

    {
      ldBlocks.map((block) => (
        <script type="application/ld+json" set:html={jsonLdScript(block)} />
      ))
    }
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <CartDrawer />
  </body>
</html>
