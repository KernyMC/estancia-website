---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  lastUpdated: string;
}

const { title, description, heading, lastUpdated } = Astro.props;
---

<Base title={title} description={description}>
  <section class="legal-hero">
    <div class="container">
      <p class="eyebrow">Legal</p>
      <h1>{heading}</h1>
      <p class="updated">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="legal-body">
    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal-hero {
    padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem;
    background: var(--sand);
  }

  .legal-hero .eyebrow {
    color: var(--brand-deep);
    margin-bottom: 0.6rem;
  }

  .legal-hero h1 {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
  }

  .updated {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .legal-body {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3.5rem, 8vw, 5.5rem);
  }

  .prose {
    max-width: 72ch;
  }

  .prose :global(h2) {
    font-size: var(--text-xl);
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    color: var(--ink-soft);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.3rem;
    color: var(--ink-soft);
    line-height: 1.75;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(a) {
    color: var(--brand-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--ink);
  }
</style>
