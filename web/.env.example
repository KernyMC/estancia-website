# Copy to .env and fill in. Never commit .env.

# Which deployment this is: production | staging | development.
# Anything but production gets X-Robots-Tag: noindex (see src/middleware.ts).
SITE_ENV=development

# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgresql://gab:gab_dev_password@localhost:5432/gab

# Stripe — use TEST keys locally, restricted key (rk_) preferred
STRIPE_SECRET_KEY=rk_test_...
# From `stripe listen` output locally; from the Dashboard webhook config in prod
STRIPE_WEBHOOK_SECRET=whsec_...

# Absolute origin for Stripe redirect URLs
PUBLIC_SITE_URL=http://localhost:4321

# Cron auth (>=16 chars). Unset locally = /api/cron/* is open for curling.
# REQUIRED on any public deployment. Send as: Authorization: Bearer <secret>
CRON_SECRET=

# Sanity webhook secret (>=16 chars) — same value set on the webhook at
# sanity.io/manage → API → Webhooks. Unset = /api/sanity-revalidate returns
# 501 (disabled), not open. Without it, the content cache only clears when
# the Node process restarts.
SANITY_REVALIDATE_SECRET=

# SMTP (Hostinger) — optional: without these, emails log to console
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BOOKING_NOTIFY_EMAIL=

# PayPal (Orders API v2 + JS SDK v6) — optional: without these, /api/paypal/*
# returns 501 and the PayPal/Venmo buttons don't render. Client ID is not
# secret (safe in frontend code); the secret must never be PUBLIC_-prefixed.
PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
