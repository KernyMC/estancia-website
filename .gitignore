# dependencies
node_modules/

# build output
dist/
.astro/

# environment — never commit secrets
.env
.env.*
!.env.example

# Dokploy API dumps (dget/dpost output) — have contained live env vars/secrets
# when redirected to a file by mistake. Never commit these (see docs/log.md).
app_status_tmp.json
*_tmp.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# sanity
.sanity/

# prisma generated client (regenerated by `prisma generate`)
web/src/server/generated/

# local db data (docker volume bind, if any)
postgres-data/

# Claude Code runtime lock (pid/session, machine-local, regenerated per run)
.claude/scheduled_tasks.lock

# Source photos from the WP scrape (~62 MB). Already uploaded to Sanity and
# referenced by asset id, so the repo does not need them — and Dokploy would
# clone them on every deploy. The manifest under migration/data/ IS versioned,
# which is what the pipeline actually needs to be reproducible.
migration/photos/
